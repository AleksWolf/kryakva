+/// How a pad's raw IMU axes sit in the body frame (P25).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Axes {
+    /// `hid-nintendo`: the raw axes are the body's.
+    AsIs,
+    /// `hid-playstation`'s DualSense: body = `[−Z, −X, +Y]` raw.
+    DualSense,
+}
+
+impl Axes {
+    fn of(device: &proto::PadImuDevice) -> Self {
+        if device.name.contains("DualSense") {
+            Self::DualSense
+        } else {
+            Self::AsIs
+        }
+    }
+
+    fn body(self, v: [f32; 3]) -> [f32; 3] {
+        match self {
+            Self::AsIs => v,
+            Self::DualSense => [-v[2], -v[0], v[1]],
+        }
+    }
+}
+
