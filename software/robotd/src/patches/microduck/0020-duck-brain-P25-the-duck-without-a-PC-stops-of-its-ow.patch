+    /// The DualSense, as Alex measured it on 08.11.2026 (P25): averaged raw accelerometer in three
+    /// poses, 8192 per g. Each comes out as the body frame says — flat: up is +Z; triggers up: up is
+    /// +X (the front); left grip down: up is −Y (the right).
+    #[test]
+    fn a_dualsense_reads_in_the_body_frame() {
+        let device = proto::PadImuDevice {
+            name: "DualSense Wireless Controller Motion Sensors".to_owned(),
+            node: "/dev/input/event5".to_owned(),
+            accel_per_g: 8192,
+            gyro_per_dps: 1024,
+            accel_max: 32767,
+            gyro_max: 32767,
+        };
+        let axes = Axes::of(&device);
+        assert_eq!(axes, Axes::DualSense);
+        let up = |raw: [f32; 3]| {
+            let b = axes.body(raw.map(|v| v / 8192.0));
+            let i = (0..3)
+                .max_by(|&a, &c| b[a].abs().total_cmp(&b[c].abs()))
+                .unwrap();
+            (i, b[i].signum())
+        };
+        assert_eq!(up([62.0, 8110.0, 1415.0]), (2, 1.0), "flat, buttons up: +Z");
+        assert_eq!(
+            up([98.0, 630.0, -8160.0]),
+            (0, 1.0),
+            "triggers up: +X, the front"
+        );
+        assert_eq!(
+            up([8241.0, -135.0, 483.0]),
+            (1, -1.0),
+            "left grip down: up is the right, −Y"
+        );
+        // A pad that is not a DualSense is read as it was.
+        let pro = proto::PadImuDevice {
+            name: "Nintendo Switch Pro Controller IMU".to_owned(),
+            ..device
+        };
+        assert_eq!(Axes::of(&pro).body([1.0, 2.0, 3.0]), [1.0, 2.0, 3.0]);
+    }
+
