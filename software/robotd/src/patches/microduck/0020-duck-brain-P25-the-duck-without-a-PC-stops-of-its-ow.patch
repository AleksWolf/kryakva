+/// The lift rule's state (P25): the legs' load smoothed, and how long it has stayed low.
+#[derive(Debug, Default)]
+struct LiftWatch {
+    load: Option<f64>,
+    low_for: f64,
+}
+
+/// Smoothing of the legs' load, seconds; and how long it has to stay under the threshold.
+const LIFT_TAU_S: f64 = 0.2;
+const LIFT_HOLD_S: f64 = 0.3;
+/// Above this tilt the duck is falling or down, and its legs unloaded for that reason.
+const LIFT_MAX_TILT: f64 = 30.0 * std::f64::consts::PI / 180.0;
+
+impl LiftWatch {
+    /// One tick; `true` once the load has stayed under `threshold` for [`LIFT_HOLD_S`].
+    fn step(&mut self, load: f64, threshold: f64, dt: f64) -> bool {
+        let a = dt / (LIFT_TAU_S + dt);
+        let smoothed = self.load.map_or(load, |l| l + a * (load - l));
+        self.load = Some(smoothed);
+        self.low_for = if smoothed < threshold { self.low_for + dt } else { 0.0 };
+        self.low_for >= LIFT_HOLD_S
+    }
+
+    fn reset(&mut self) {
+        *self = Self::default();
+    }
+}
