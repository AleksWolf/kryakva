+    /// `read_current` (P25): the tick reads 56..70, the current comes back signed per joint, and
+    /// the legs' load is the mean |current| over hip pitch, knee and ankle of both legs.
+    #[test]
+    fn the_current_and_the_legs_load_come_with_the_tick() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        for (k, &j) in LOAD_JOINTS.iter().enumerate() {
+            // Sign-magnitude, bit 15 the sign: alternate signs, magnitudes 100..600.
+            let m = 100 * (k as u16 + 1);
+            emu.servo_mut(JOINT_IDS[j]).unwrap().set(
+                69,
+                2,
+                if k % 2 == 1 { m | 0x8000 } else { m },
+            );
+        }
+        emu.servo_mut(JOINT_IDS[0]).unwrap().set(69, 2, 999); // hip yaw: not a load joint
+        let cfg = FeetechConfig {
+            read_current: true,
+            ..quick()
+        };
+        let mut with = io(emu, cfg);
+        with.read().unwrap();
+        assert_eq!(with.leg_load(), Some(350.0), "mean of 100..600");
+        let snap = with.shared().snapshot();
+        assert_eq!(snap.leg_load, Some(350.0));
+        assert_eq!(snap.currents[LOAD_JOINTS[1]], Some(-200));
+        assert_eq!(snap.currents[0], Some(999));
+        let j = with.journal().unwrap();
+        assert_eq!(j["cur_raw"][LOAD_JOINTS[0]], 100);
+        // Off, nothing changes: 7 bytes, no current, no load.
+        let mut without = io(Emulator::new(&JOINT_IDS), quick());
+        without.read().unwrap();
+        assert_eq!(without.leg_load(), None);
+        assert!(without.journal().unwrap().get("cur_raw").is_none());
+    }
