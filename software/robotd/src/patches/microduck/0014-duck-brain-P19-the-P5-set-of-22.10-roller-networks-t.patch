+    Rollers,
+}
+
+/// Height of the trunk origin above the lowest contact point, metres, along gravity (`gravity`:
+/// unit, trunk frame, upright `[0, 0, −1]`).
+pub fn trunk_height(positions: &[f64; NUM_JOINTS], gravity: &[f64; 3], feet: Feet) -> f64 {
+    use stance_model::*;
     let n = gravity.iter().map(|g| g * g).sum::<f64>().sqrt().max(1e-9);
     let down: [f64; 3] = std::array::from_fn(|i| gravity[i] / n);
-    reach(
-        &stance_model::LEFT_CHAIN,
-        &stance_model::LEFT_SOLE,
-        positions,
-        &down,
-    )
-    .max(reach(
-        &stance_model::RIGHT_CHAIN,
-        &stance_model::RIGHT_SOLE,
-        positions,
-        &down,
-    ))
+    let (left, right): (Leg, Leg) = match feet {
+        Feet::Legs => (
+            (&LEGS_LEFT_CHAIN, &LEGS_LEFT_CONTACT),
+            (&LEGS_RIGHT_CHAIN, &LEGS_RIGHT_CONTACT),
