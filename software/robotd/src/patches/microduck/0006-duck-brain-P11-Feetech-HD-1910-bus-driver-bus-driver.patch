+    /// The newest host sample goes into the read, and a tick that sees the same one again counts
+    /// as stale.
+    #[test]
+    fn the_host_imu_sample_rides_the_read() {
+        let feed = Arc::new(ImuFeed::new());
+        let mut io = FeetechIo::with_port(
+            Emulator::new(&JOINT_IDS),
+            quick(),
+            Arc::default(),
+            Arc::clone(&feed),
+        );
+        io.census().unwrap();
+        let tilted = ImuData {
+            gravity: [0.0, -1.0, 0.0],
+            ..ImuData::default()
+        };
+        feed.publish(
+            HostSample {
+                imu: tilted,
+                at: Instant::now(),
+                seq: 7,
+            },
+            true,
+        );
+        assert!(io.imu_ready());
+        assert_eq!(io.read().unwrap().imu.gravity, [0.0, -1.0, 0.0]);
+        io.read().unwrap();
+        assert_eq!(io.imu_stale(), ImuStale { total: 1, run: 1 });
+        assert!(io.shared().snapshot().imu_age_last_ms.is_some());
+    }
