+//! The Feetech HD-1910 bus in `robotd` (duck-brain patch P11): `[bus] driver = "feetech"`.
+//!
+//! The driver is `duck_control::feetech`; this is what the daemon does around it — turn
+//! `[feetech]` into its config, wait for every servo before the loop starts, and say what the bus
+//! is doing in `robot.health`.
+
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use duck_control::feetech::{FeetechConfig, FeetechIo, FeetechShared, VelocitySource};
+use duck_control::host_imu::ImuFeed;
+use duck_control::{JOINT_IDS, JOINT_NAMES, NUM_JOINTS};
+use duck_ipc_proto as proto;
+use robotd_params::{FeetechEcho, FeetechVelocity, Params};
+
+use crate::{RobotState, STARTUP_READ_LOG_EVERY, STARTUP_RETRY_INTERVAL};
+
+/// `[feetech]` as the driver takes it.
+pub fn config(params: &Params) -> FeetechConfig {
+    let f = &params.feetech;
+    let period = params.period().as_secs_f64();
+    FeetechConfig {
+        baud: f.baud,
+        read_timeout: Duration::from_secs_f64(f.read_timeout_ms / 1000.0),
+        echo: match f.echo {
+            FeetechEcho::Auto => feetech::Echo::Auto,
+            FeetechEcho::Off => feetech::Echo::Off,
+        },
+        sign: f.sign.to_array().map(f64::from),
+        torque: feetech::TorqueOn {
+            p: f.p,
+            d: f.d,
+            torque_limit: f.torque_limit,
+            speed: f.speed,
+            retries: f.write_retries,
+        },
+        gain_ref: params.policy.gain,
+        voltage_adapt: f.voltage_adapt,
+        nominal_v: f.adapt_nominal_v,
+        adapt_band: (f.adapt_min_v, f.adapt_max_v),
+        // An exponential filter with time constant τ, sampled once a tick.
+        voltage_alpha: 1.0 - (-period / f.voltage_tau_s).exp(),
+        cutoff_v: f.cutoff_v,
+        cutoff_ticks: f.cutoff_ticks,
+        velocity: match f.velocity {
+            FeetechVelocity::PositionDelta => VelocitySource::PositionDelta,
+            FeetechVelocity::Register => VelocitySource::Register,
+        },
+        speed_rad_per_count: f.speed_rad_per_count,
+        // About once a second.
+        temperature_every: params.control.hz.max(1),
+    }
+}
+
+/// Open the bus and wait until every servo has answered once — a joint that has never answered
+/// has no position to hold. The same waiting rules as the Dynamixel bus: one line now, one every
+/// thirty attempts, the missing ids in `robot.health`.
+///
+/// `None` only if shutdown is asked for while waiting.
+pub async fn open_waiting(
+    params: &Params,
+    state: &RobotState,
+    imu: Arc<ImuFeed>,
+) -> Option<FeetechIo> {
+    let cfg = config(params);
+    let shared = Arc::new(FeetechShared::default());
+    let port = params.bus.port.as_str();
+    let mut io: Option<FeetechIo> = None;
+    let mut attempt = 0u32;
+    if params.policy.voltage_adapt && cfg.voltage_adapt {
+        tracing::info!(
+            "[feetech] voltage_adapt multiplies the servo error; [policy] voltage_adapt stands down"
+        );
+    }
+    while !state.shutdown.load(Ordering::Relaxed) {
+        let loud = attempt == 0 || attempt.is_multiple_of(STARTUP_READ_LOG_EVERY);
+        if io.is_none() {
+            match FeetechIo::open(port, cfg.clone(), Arc::clone(&shared), Arc::clone(&imu)) {
+                Ok(opened) => io = Some(opened),
+                Err(e) => {
+                    if loud {
+                        tracing::error!(error = %e, port, attempt, "cannot open the Feetech bus; waiting");
+                    }
+                }
+            }
+        }
+        let mut missing = Vec::new();
+        if let Some(bus) = io.as_mut() {
+            match bus.census() {
+                Ok(silent) if silent.is_empty() => {
+                    state.startup_bus_failures.store(0, Ordering::Relaxed);
+                    state.startup_missing.store(Arc::new(Vec::new()));
+                    let _ = state.feetech.set(Arc::clone(&shared));
+                    tracing::info!(
+                        port,
+                        servos = NUM_JOINTS,
+                        "Feetech bus up: every servo answers"
+                    );
+                    return io;
+                }
+                Ok(silent) => {
+                    if loud {
+                        if silent.len() == NUM_JOINTS {
+                            tracing::error!(
+                                attempt,
+                                "no servo answers on the Feetech bus; waiting, is servo power on?"
+                            );
+                        } else {
+                            tracing::error!(
+                                ?silent,
+                                attempt,
+                                "servos not answering on the Feetech bus; waiting"
+                            );
+                        }
+                    }
+                    missing = silent;
+                }
+                Err(e) => {
+                    if loud {
+                        tracing::error!(error = %e, attempt, "Feetech bus read failed; reopening");
+                    }
+                    io = None;
+                }
+            }
+        }
+        attempt += 1;
+        state.startup_missing.store(Arc::new(missing));
+        state.startup_bus_failures.store(attempt, Ordering::Relaxed);
+        tokio::time::sleep(STARTUP_RETRY_INTERVAL).await;
+    }
+    None
+}
+
+/// `robot.health`'s `feetech` block.
+pub fn health(shared: &FeetechShared) -> proto::FeetechHealth {
+    let s = shared.snapshot();
+    proto::FeetechHealth {
+        ticks: s.ticks,
+        period_ms_p50: s.period_ms.0,
+        period_ms_p99: s.period_ms.1,
+        obs_age_ms_p50: s.obs_age_ms.0,
+        obs_age_ms_p99: s.obs_age_ms.1,
+        imu_age_ms_p50: s.imu_age_ms.0,
+        imu_age_ms_p99: s.imu_age_ms.1,
+        imu_age_ms_last: s.imu_age_last_ms,
+        imu_stale_ticks: s.imu_stale.total,
+        imu_stale_run: s.imu_stale.run,
+        volts_min: s.v_min,
+        volts_median: s.v_median,
+        volts_smoothed: s.v_smoothed,
+        adapt: s.adapt,
+        cutoff: s.cutoff,
+        torque: s.torque,
+        rewrites: s.rewrites,
+        write_failures: s.write_failures,
+        echoes: s.echoes,
+        bad_packets: s.bad_packets,
+        stray: s.stray,
+        servos: (0..NUM_JOINTS)
+            .map(|j| proto::ServoHealth {
+                id: JOINT_IDS[j],
+                joint: JOINT_NAMES[j].to_owned(),
+                misses: s.misses[j],
+                consecutive_misses: s.consecutive_misses[j],
+                volts: s.volts[j],
+                temp_c: s.temps_c[j],
+                error: s.errors[j],
+            })
+            .collect(),
+    }
+}
+
+/// `robotd init` on a Feetech robot: refused, with the way that works. The standalone ramp goes to
+/// Pollen's compiled home pose, which is not this robot's; `robotctl robot init` with the daemon
+/// running ramps to the walking policy's own HOME (P6), over two seconds, through the verified
+/// torque-on.
+pub fn refuse_init() -> std::process::ExitCode {
+    tracing::error!(
+        "robotd init does not drive the Feetech bus: start robotd and run `robotctl robot init` \
+         (torque on, then a 2 s ramp to the walking policy's HOME)"
+    );
+    std::process::ExitCode::FAILURE
+}
