+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::host_imu::HostSample;
+    use feetech::emu::Emulator;
+
+    fn io(emu: Emulator, cfg: FeetechConfig) -> FeetechIo<Emulator> {
+        let mut io = FeetechIo::with_port(emu, cfg, Arc::default(), Arc::new(ImuFeed::new()));
+        assert!(io.census().unwrap().is_empty());
+        io
+    }
+
+    fn quick() -> FeetechConfig {
+        FeetechConfig {
+            read_timeout: Duration::from_millis(3),
+            ..FeetechConfig::default()
+        }
+    }
+
+    #[test]
+    fn counts_and_radians() {
+        assert_eq!(counts_to_rad(2048, 1.0), 0.0);
+        assert!((counts_to_rad(3072, 1.0) - std::f64::consts::FRAC_PI_2).abs() < 1e-12);
+        assert!((counts_to_rad(3072, -1.0) + std::f64::consts::FRAC_PI_2).abs() < 1e-12);
+        assert_eq!(rad_to_counts(0.0, 1.0), 2048);
+        assert_eq!(rad_to_counts(std::f64::consts::FRAC_PI_2, -1.0), 1024);
+        assert_eq!(rad_to_counts(10.0, 1.0), 4095, "clamped");
+        for raw in [0u16, 1, 1000, 2048, 4095] {
+            assert_eq!(rad_to_counts(counts_to_rad(raw, -1.0), -1.0), raw);
+        }
+    }
+
+    /// The tick: a sync write of 42 and a sync read of 56 for seven bytes, all fifteen ids.
+    #[test]
+    fn a_tick_is_one_sync_write_and_one_sync_read() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(12).unwrap().set(56, 2, 2048 + 512);
+        let mut io = io(
+            emu,
+            FeetechConfig {
+                temperature_every: 0,
+                ..quick()
+            },
+        );
+        let s = io.read().unwrap();
+        let j = JOINT_IDS.iter().position(|&id| id == 12).unwrap();
+        assert!((s.positions[j] - std::f64::consts::FRAC_PI_4).abs() < 1e-12);
+        io.write(&JointTargets::new(s.positions)).unwrap();
+        let log = &io.bus_mut().port_mut().log;
+        let tick: Vec<(u8, u8, u8)> = log.iter().rev().take(2).rev().copied().collect();
+        assert_eq!(tick, vec![(0xFE, 0x82, 56), (0xFE, 0x83, 42)]);
+    }
+
+    /// One servo silent for a while: the tick still succeeds, its joint holds the last position,
+    /// and the misses are counted against its id.
+    #[test]
+    fn a_silent_servo_holds_its_last_position_and_is_counted() {
+        let emu = Emulator::new(&JOINT_IDS);
+        let mut io = io(emu, quick());
+        let j = 3;
+        io.bus_mut()
+            .port_mut()
+            .servo_mut(JOINT_IDS[j])
+            .unwrap()
+            .set(56, 2, 2100);
+        let before = io.read().unwrap().positions[j];
+        io.bus_mut()
+            .port_mut()
+            .servo_mut(JOINT_IDS[j])
+            .unwrap()
+            .silent = true;
+        io.bus_mut()
+            .port_mut()
+            .servo_mut(JOINT_IDS[j])
+            .unwrap()
+            .set(56, 2, 3000);
+        for _ in 0..4 {
+            let s = io.read().expect("one silent servo is not a failed tick");
+            assert_eq!(s.positions[j], before);
+        }
+        let snap = io.shared().snapshot();
+        assert_eq!(snap.misses[j], 4);
+        assert_eq!(snap.consecutive_misses[j], 4);
+        assert_eq!(snap.misses.iter().sum::<u64>(), 4, "nobody else missed");
+        io.bus_mut()
+            .port_mut()
+            .servo_mut(JOINT_IDS[j])
+            .unwrap()
+            .silent = false;
+        assert_ne!(io.read().unwrap().positions[j], before);
+        assert_eq!(io.shared().snapshot().consecutive_misses[j], 0);
+    }
+
+    #[test]
+    fn nobody_answering_is_an_error() {
+        let emu = Emulator::new(&JOINT_IDS);
+        let mut io = io(emu, quick());
+        for id in JOINT_IDS {
+            io.bus_mut().port_mut().servo_mut(id).unwrap().silent = true;
+        }
+        assert!(io.read().is_err());
+    }
+
+    /// The direction sign applies both ways: a joint flipped in the config reads and commands
+    /// the mirror image.
+    #[test]
+    fn the_sign_flips_reads_and_goals() {
+        let mut cfg = quick();
+        cfg.sign[0] = -1.0;
+        cfg.voltage_adapt = false;
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(JOINT_IDS[0]).unwrap().set(56, 2, 2048 + 100);
+        let mut io = io(emu, cfg);
+        let s = io.read().unwrap();
+        assert!(s.positions[0] < 0.0);
+        let mut t = s.positions;
+        t[0] = 0.5;
+        io.write(&JointTargets::new(t)).unwrap();
+        let goal = io
+            .bus_mut()
+            .port_mut()
+            .servo(JOINT_IDS[0])
+            .unwrap()
+            .get(42, 2);
+        assert_eq!(goal, rad_to_counts(0.5, -1.0));
+        assert!(goal < 2048);
+    }
+
+    /// The error sent is multiplied by 7.4 / V: at 6.0 V (and below, clamped) a 0.1 rad error
+    /// goes out as 0.1233 rad.
+    #[test]
+    fn voltage_adapt_scales_the_error_by_nominal_over_v() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        for id in JOINT_IDS {
+            emu.servo_mut(id).unwrap().set(62, 1, 50); // 5.0 V: below the band, above the cutoff
+        }
+        let mut io = io(emu, quick());
+        let s = io.read().unwrap();
+        let mut t = s.positions;
+        t[0] += 0.1;
+        io.write(&JointTargets::new(t)).unwrap();
+        let k = 7.4 / 6.0;
+        let snap = io.shared().snapshot();
+        assert!((snap.adapt - k).abs() < 1e-12, "{}", snap.adapt);
+        let goal = io
+            .bus_mut()
+            .port_mut()
+            .servo(JOINT_IDS[0])
+            .unwrap()
+            .get(42, 2);
+        assert_eq!(goal, rad_to_counts(s.positions[0] + 0.1 * k, 1.0));
+        // Off: the target goes out as it is.
+        let mut cfg = quick();
+        cfg.voltage_adapt = false;
+        let mut io = super::tests::io(Emulator::new(&JOINT_IDS), cfg);
+        let s = io.read().unwrap();
+        io.write(&JointTargets::new(s.positions)).unwrap();
+        assert_eq!(io.shared().snapshot().adapt, 1.0);
+    }
+
+    /// V is smoothed per tick from the lowest servo, seeded by the first reading.
+    #[test]
+    fn voltage_is_the_smoothed_minimum() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(13).unwrap().set(62, 1, 70);
+        let mut io = io(
+            emu,
+            FeetechConfig {
+                voltage_alpha: 0.5,
+                ..quick()
+            },
+        );
+        io.read().unwrap();
+        assert_eq!(io.shared().snapshot().v_smoothed, Some(7.0));
+        io.bus_mut()
+            .port_mut()
+            .servo_mut(13)
+            .unwrap()
+            .set(62, 1, 74);
+        io.read().unwrap();
+        let snap = io.shared().snapshot();
+        assert!((snap.v_smoothed.unwrap() - 7.2).abs() < 1e-12);
+        assert_eq!(snap.v_min, Some(7.4));
+        assert_eq!(snap.v_median, Some(7.4));
+    }
+
+    /// Five ticks in a row below 4.5 V and the torque goes off; four do not.
+    #[test]
+    fn five_ticks_below_the_cutoff_take_torque_off() {
+        let mut io = io(Emulator::new(&JOINT_IDS), quick());
+        io.set_torque(true).unwrap();
+        let set_v = |io: &mut FeetechIo<Emulator>, v: u16| {
+            io.bus_mut().port_mut().servo_mut(24).unwrap().set(62, 1, v);
+        };
+        set_v(&mut io, 44);
+        for _ in 0..4 {
+            io.read().unwrap();
+        }
+        set_v(&mut io, 74);
+        io.read().unwrap();
+        assert!(!io.shared().snapshot().cutoff, "four is not five");
+        set_v(&mut io, 44);
+        for _ in 0..5 {
+            io.read().unwrap();
+        }
+        let snap = io.shared().snapshot();
+        assert!(snap.cutoff);
+        assert_eq!(snap.torque, Some(false));
+        assert_eq!(io.bus_mut().port_mut().servo(10).unwrap().get(40, 1), 0);
+        // Torque on again clears it.
+        set_v(&mut io, 74);
+        io.read().unwrap();
+        io.set_torque(true).unwrap();
+        assert!(!io.shared().snapshot().cutoff);
+    }
+
+    /// Velocity, by default, is the position change over the time between two reads.
+    #[test]
+    fn velocity_is_the_position_difference_over_time() {
+        let mut io = io(Emulator::new(&JOINT_IDS), quick());
+        io.read().unwrap();
+        std::thread::sleep(Duration::from_millis(20));
+        io.bus_mut()
+            .port_mut()
+            .servo_mut(20)
+            .unwrap()
+            .set(56, 2, 2048 + 41);
+        let t0 = Instant::now();
+        let s = io.read().unwrap();
+        let dt_max = 0.020 + t0.elapsed().as_secs_f64() + 0.010;
+        let dp = counts_to_rad(2048 + 41, 1.0);
+        assert!(
+            s.velocities[0] > dp / dt_max && s.velocities[0] < dp / 0.020,
+            "{}",
+            s.velocities[0]
+        );
+        // From the register instead.
+        let mut io = super::tests::io(
+            Emulator::new(&JOINT_IDS),
+            FeetechConfig {
+                velocity: VelocitySource::Register,
+                ..quick()
+            },
+        );
+        io.bus_mut()
+            .port_mut()
+            .servo_mut(20)
+            .unwrap()
+            .set(58, 2, 0x8000 | 100);
+        let s = io.read().unwrap();
+        assert!((s.velocities[0] + 100.0 * TAU / 4096.0).abs() < 1e-12);
+    }
