+    #[test]
+    fn a_feetech_robot_loads_with_signs_by_joint_name() {
+        let p = load("[bus]\ndriver = \"feetech\"\n[feetech.sign]\nleft_knee = -1\n").unwrap();
+        assert_eq!(p.bus.driver, BusDriver::Feetech);
+        let signs = p.feetech.sign.to_array();
+        assert_eq!(signs[3], -1);
+        assert_eq!(signs.iter().filter(|s| **s == 1).count(), 14);
+        assert_eq!((p.feetech.p, p.feetech.d, p.feetech.speed), (32, 40, 10000));
+    }
+
+    #[test]
+    fn bad_feetech_values_are_refused_by_name() {
+        let err = load("[bus]\ndriver = \"feetech\"\n[feetech.sign]\nmouth = 2\n").unwrap_err();
+        assert!(err.to_string().contains("feetech.sign.mouth"), "{err}");
+        let err = load("[bus]\ndriver = \"feetech\"\n[feetech]\nread_timeout_ms = 25.0\n").unwrap_err();
+        assert!(err.to_string().contains("feetech.read_timeout_ms"), "{err}");
+        let err = load("[bus]\ndriver = \"feetech\"\n[feetech]\nspeed = 0\n").unwrap_err();
+        assert!(err.to_string().contains("feetech.speed"), "{err}");
+        // A Dynamixel robot never reads the section, so it never fails over it.
+        assert!(load("[feetech]\nspeed = 0\n").is_ok());
+    }
+}
