+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub feetech: Option<FeetechHealth>,
+}
+
+/// What the Feetech driver has seen since it started (duck-brain P11). Percentiles are over the
+/// last ten seconds of ticks.
+#[derive(Debug, Clone, PartialEq, Default, Serialize, Deserialize)]
+pub struct FeetechHealth {
+    pub ticks: u64,
+    /// Time between the starts of successive tick reads, ms.
+    pub period_ms_p50: Option<f64>,
+    pub period_ms_p99: Option<f64>,
+    /// From the start of the read to the goal write, ms: how old the observation the goals were
+    /// computed from is when they go out.
+    pub obs_age_ms_p50: Option<f64>,
+    pub obs_age_ms_p99: Option<f64>,
+    /// Age of the IMU sample a tick used, at the start of its read, ms.
+    pub imu_age_ms_p50: Option<f64>,
+    pub imu_age_ms_p99: Option<f64>,
+    pub imu_age_ms_last: Option<f64>,
+    /// Ticks that got no new IMU sample, in total and running.
+    pub imu_stale_ticks: u64,
+    pub imu_stale_run: u64,
+    /// Lowest and median servo voltage of the last read, the smoothed lowest, and the factor
+    /// errors were last multiplied by (1 when the adaptation is off). Register 62 as read.
+    pub volts_min: Option<f64>,
+    pub volts_median: Option<f64>,
+    pub volts_smoothed: Option<f64>,
+    pub adapt: f64,
+    /// Torque was cut for undervoltage and has not been switched on since.
+    pub cutoff: bool,
+    /// Last torque state written, `None` before the first.
+    pub torque: Option<bool>,
+    /// Register writes that read back different and were rewritten; writes that never did.
+    pub rewrites: u64,
+    pub write_failures: u64,
+    /// Our own bytes heard back, packets dropped for a bad checksum, answers nobody asked for.
+    pub echoes: u64,
+    pub bad_packets: u64,
+    pub stray: u64,
+    pub servos: Vec<ServoHealth>,
+}
+
+/// One servo on the Feetech bus.
+#[derive(Debug, Clone, PartialEq, Default, Serialize, Deserialize)]
+pub struct ServoHealth {
+    pub id: u8,
+    pub joint: String,
+    /// Tick reads it did not answer, in total and running.
+    pub misses: u64,
+    pub consecutive_misses: u32,
+    pub volts: Option<f64>,
+    pub temp_c: Option<f64>,
+    /// The error byte of its last answer; 0 is none.
+    pub error: u8,
 }
 
