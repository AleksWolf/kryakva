+//! The Feetech bus: fifteen HD-1910 servos on a half-duplex TTL line (duck-brain patch P11).
+//!
+//! The tick is two transactions, by the duck-brain register table:
+//!
+//! - one `sync_write` of goal (42, 2 bytes) to every joint;
+//! - one `sync_read` of 56..62 (7 bytes: position, speed, load, voltage) from every joint —
+//!   once a second 56..63 instead, one byte longer, which brings the temperature (63) along
+//!   rather than spending a transaction of its own on it.
+//!
+//! A servo that does not answer the read is not a failed tick: its joint keeps the position it
+//! last reported, the miss is counted per id, and `robot.health` shows the count. Only a read
+//! that nobody answers is an error.
+//!
+//! What this driver does *not* do, deliberately: write `homing_offset` or anything else in
+//! EEPROM (each servo's zero is set when it is calibrated, with its ID — P9), reboot a servo
+//! (there is no reboot here), or filter what it reads or writes (the policies were trained
+//! without filters).
+//!
+//! Orientation does not come over this bus: the IMU is the host's (P12), handed over through an
+//! [`ImuFeed`] and taken, newest sample first, at the start of each read.
+
+use std::collections::VecDeque;
+use std::f64::consts::TAU;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use feetech::{Bus, Echo, Mismatch, Port, SerialPort, TorqueOn, reg};
+
+use crate::host_imu::{ImuFeed, age};
+use crate::imu::ImuData;
+use crate::io::{ImuStale, IoError, JointTargets, Result, RobotIo, Sensors, SlowSensors};
+use crate::model::{JOINT_IDS, JOINT_NAMES, NUM_JOINTS};
+
+/// Where the observation's joint velocity comes from (`[feetech] velocity`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum VelocitySource {
+    /// Position change since the servo's previous answer, over the time between the two reads.
+    PositionDelta,
+    /// Present speed (58, sign in bit 15), times [`FeetechConfig::speed_rad_per_count`].
+    Register,
+}
+
+/// Everything the driver is told by `robotd.toml`'s `[feetech]` section. Values marked
+/// "замерить" in the shipped file are guesses until measured on the robot.
+#[derive(Debug, Clone, PartialEq)]
+pub struct FeetechConfig {
+    pub baud: u32,
+    pub read_timeout: Duration,
+    pub echo: Echo,
+    /// Per-joint direction, ±1, indexed as [`JOINT_NAMES`].
+    pub sign: [f64; NUM_JOINTS],
+    pub torque: TorqueOn,
+    /// The `[policy] gain` the configured P belongs to: `set_gain(kp)` writes
+    /// `P × kp / gain_ref`, so the policy gain is P itself and `gain_limp` is the same fraction
+    /// of P that it is of the policy gain.
+    pub gain_ref: u16,
+    pub voltage_adapt: bool,
+    /// 7.4 V: the error sent to a servo is multiplied by `nominal_v / V`.
+    pub nominal_v: f64,
+    /// V is clamped to this band before it divides anything: 6.0–9.5 V.
+    pub adapt_band: (f64, f64),
+    /// Weight of a new reading in the per-tick smoothing of V (exponential).
+    pub voltage_alpha: f64,
+    /// Torque off when the lowest servo reads below this for `cutoff_ticks` ticks in a row.
+    pub cutoff_v: f64,
+    pub cutoff_ticks: u32,
+    pub velocity: VelocitySource,
+    pub speed_rad_per_count: f64,
+    /// Ticks between the reads that also bring the temperature.
+    pub temperature_every: u32,
+}
+
+impl Default for FeetechConfig {
+    fn default() -> Self {
+        Self {
+            baud: 1_000_000,
+            read_timeout: Duration::from_millis(12),
+            echo: Echo::Auto,
+            sign: [1.0; NUM_JOINTS],
+            torque: TorqueOn {
+                p: 32,
+                d: 40,
+                torque_limit: 1000,
+                speed: 10000,
+                retries: 5,
+            },
+            gain_ref: 200,
+            voltage_adapt: true,
+            nominal_v: 7.4,
+            adapt_band: (6.0, 9.5),
+            voltage_alpha: 0.02,
+            cutoff_v: 4.5,
+            cutoff_ticks: 5,
+            velocity: VelocitySource::PositionDelta,
+            speed_rad_per_count: TAU / feetech::COUNTS_PER_TURN,
+            temperature_every: 50,
+        }
+    }
+}
+
+/// Radians from a position register, `sign` applied.
+pub fn counts_to_rad(raw: u16, sign: f64) -> f64 {
+    sign * (f64::from(feetech::sign_magnitude(raw)) - feetech::CENTER) * TAU
+        / feetech::COUNTS_PER_TURN
+}
+
+/// A goal register from radians, `sign` applied, rounded and clamped to 0..=4095.
+pub fn rad_to_counts(rad: f64, sign: f64) -> u16 {
+    let counts = feetech::CENTER + (sign * rad * feetech::COUNTS_PER_TURN / TAU).round();
+    counts.clamp(0.0, feetech::COUNTS_PER_TURN - 1.0) as u16
+}
+
+/// The last `CAP` values of a timing, for percentiles.
+#[derive(Debug, Clone, Default)]
+struct Window(VecDeque<u32>);
+
+impl Window {
+    const CAP: usize = 500; // 10 s at 50 Hz
+
+    fn push(&mut self, d: Duration) {
+        if self.0.len() == Self::CAP {
+            self.0.pop_front();
+        }
+        self.0
+            .push_back(d.as_micros().min(u128::from(u32::MAX)) as u32);
+    }
+
+    /// p-th percentile in ms, nearest rank.
+    fn percentile_ms(&self, p: f64) -> Option<f64> {
+        if self.0.is_empty() {
+            return None;
+        }
+        let mut v: Vec<u32> = self.0.iter().copied().collect();
+        v.sort_unstable();
+        let rank = ((p / 100.0) * v.len() as f64).ceil().max(1.0) as usize - 1;
+        Some(f64::from(v[rank.min(v.len() - 1)]) / 1000.0)
+    }
+}
+
+/// What `robot.health` reports about the bus, filled by the driver as it runs.
+#[derive(Debug, Clone, Default)]
+struct Stats {
+    ticks: u64,
+    periods: Window,
+    obs_ages: Window,
+    imu_ages: Window,
+    misses: [u64; NUM_JOINTS],
+    run: [u32; NUM_JOINTS],
+    volts: [Option<f64>; NUM_JOINTS],
+    temps: [Option<f64>; NUM_JOINTS],
+    errors: [u8; NUM_JOINTS],
+    v_smoothed: Option<f64>,
+    adapt: f64,
+    cutoff: bool,
+    torque: Option<bool>,
+    rewrites: u64,
+    write_failures: u64,
+    counters: feetech::Counters,
+    imu_stale: ImuStale,
+    imu_age_last: Option<Duration>,
+}
+
+/// The driver's numbers, shared with whoever answers `robot.health`.
+pub struct FeetechShared(Mutex<Stats>);
+
+impl Default for FeetechShared {
+    fn default() -> Self {
+        // Nothing multiplied yet is a factor of one, not zero.
+        Self(Mutex::new(Stats {
+            adapt: 1.0,
+            ..Stats::default()
+        }))
+    }
+}
+
+/// A copy of [`FeetechShared`] at one moment.
+#[derive(Debug, Clone, PartialEq, Default)]
+pub struct FeetechSnapshot {
+    pub ticks: u64,
+    pub period_ms: (Option<f64>, Option<f64>),
+    pub obs_age_ms: (Option<f64>, Option<f64>),
+    pub imu_age_ms: (Option<f64>, Option<f64>),
+    pub imu_age_last_ms: Option<f64>,
+    pub misses: [u64; NUM_JOINTS],
+    pub consecutive_misses: [u32; NUM_JOINTS],
+    pub volts: [Option<f64>; NUM_JOINTS],
+    pub v_min: Option<f64>,
+    pub v_median: Option<f64>,
+    pub v_smoothed: Option<f64>,
+    pub adapt: f64,
+    pub temps_c: [Option<f64>; NUM_JOINTS],
+    pub errors: [u8; NUM_JOINTS],
+    pub cutoff: bool,
+    pub torque: Option<bool>,
+    pub rewrites: u64,
+    pub write_failures: u64,
+    pub echoes: u64,
+    pub bad_packets: u64,
+    pub stray: u64,
+    pub imu_stale: ImuStale,
+}
+
+impl FeetechShared {
+    pub fn snapshot(&self) -> FeetechSnapshot {
+        let s = self.0.lock().unwrap();
+        let mut known: Vec<f64> = s.volts.iter().flatten().copied().collect();
+        known.sort_by(f64::total_cmp);
+        let median = (!known.is_empty()).then(|| {
+            let n = known.len();
+            if n % 2 == 1 {
+                known[n / 2]
+            } else {
+                (known[n / 2 - 1] + known[n / 2]) / 2.0
+            }
+        });
+        FeetechSnapshot {
+            ticks: s.ticks,
+            period_ms: (s.periods.percentile_ms(50.0), s.periods.percentile_ms(99.0)),
+            obs_age_ms: (
+                s.obs_ages.percentile_ms(50.0),
+                s.obs_ages.percentile_ms(99.0),
+            ),
+            imu_age_ms: (
+                s.imu_ages.percentile_ms(50.0),
+                s.imu_ages.percentile_ms(99.0),
+            ),
+            imu_age_last_ms: s.imu_age_last.map(|d| d.as_secs_f64() * 1000.0),
+            misses: s.misses,
+            consecutive_misses: s.run,
+            volts: s.volts,
+            v_min: known.first().copied(),
+            v_median: median,
+            v_smoothed: s.v_smoothed,
+            adapt: s.adapt,
+            temps_c: s.temps,
+            errors: s.errors,
+            cutoff: s.cutoff,
+            torque: s.torque,
+            rewrites: s.rewrites,
+            write_failures: s.write_failures,
+            echoes: s.counters.echoes,
+            bad_packets: s.counters.bad_packets,
+            stray: s.counters.stray,
+            imu_stale: s.imu_stale,
+        }
+    }
+}
+
+pub struct FeetechIo<P: Port = SerialPort> {
+    bus: Bus<P>,
+    cfg: FeetechConfig,
+    shared: Arc<FeetechShared>,
+    imu: Arc<ImuFeed>,
+    positions: [f64; NUM_JOINTS],
+    velocities: [f64; NUM_JOINTS],
+    /// Each servo's last answer: position and when the read that brought it started.
+    last_answer: [Option<(f64, Instant)>; NUM_JOINTS],
+    volts: [Option<f64>; NUM_JOINTS],
+    temps: [Option<f64>; NUM_JOINTS],
+    v_smoothed: Option<f64>,
+    low_ticks: u32,
+    cutoff: bool,
+    kp: Option<u16>,
+    read_started: Option<Instant>,
+    imu_seq: Option<u64>,
+    imu_stale: ImuStale,
+    tick: u64,
+}
+
+impl FeetechIo<SerialPort> {
+    /// Open the port. No bus traffic: [`Self::census`] is the first.
+    pub fn open(
+        port: &str,
+        cfg: FeetechConfig,
+        shared: Arc<FeetechShared>,
+        imu: Arc<ImuFeed>,
+    ) -> Result<Self> {
+        let serial = SerialPort::open(port, cfg.baud).map_err(|source| IoError::Port {
+            path: port.to_owned(),
+            source,
+        })?;
+        Ok(Self::with_port(serial, cfg, shared, imu))
+    }
+}
+
+impl<P: Port> FeetechIo<P> {
+    pub fn with_port(
+        port: P,
+        cfg: FeetechConfig,
+        shared: Arc<FeetechShared>,
+        imu: Arc<ImuFeed>,
+    ) -> Self {
+        let bus = Bus::new(port, cfg.read_timeout, cfg.echo);
+        Self {
+            bus,
+            cfg,
+            shared,
+            imu,
+            positions: [0.0; NUM_JOINTS],
+            velocities: [0.0; NUM_JOINTS],
+            last_answer: [None; NUM_JOINTS],
+            volts: [None; NUM_JOINTS],
+            temps: [None; NUM_JOINTS],
+            v_smoothed: None,
+            low_ticks: 0,
+            cutoff: false,
+            kp: None,
+            read_started: None,
+            imu_seq: None,
+            imu_stale: ImuStale::default(),
+            tick: 0,
+        }
+    }
+
+    /// The joint ids that do not answer one read of the tick's block. Run until it is empty
+    /// before the loop starts: a joint that has never answered has no position to hold.
+    pub fn census(&mut self) -> Result<Vec<u8>> {
+        let answers = self
+            .bus
+            .sync_read(&JOINT_IDS, reg::POSITION.0, 7)
+            .map_err(|e| IoError::Bus(format!("census sync_read: {e}")))?;
+        let now = Instant::now();
+        let mut missing = Vec::new();
+        for (j, a) in answers.iter().enumerate() {
+            match a {
+                Some(s) => {
+                    let p = counts_to_rad(feetech::from_le(&s.params[0..2]), self.cfg.sign[j]);
+                    self.positions[j] = p;
+                    self.last_answer[j] = Some((p, now));
+                    self.volts[j] = Some(f64::from(s.params[6]) * 0.1);
+                }
+                None => missing.push(JOINT_IDS[j]),
+            }
+        }
+        Ok(missing)
+    }
+
+    pub fn shared(&self) -> Arc<FeetechShared> {
+        Arc::clone(&self.shared)
+    }
+
+    pub fn bus_mut(&mut self) -> &mut Bus<P> {
+        &mut self.bus
+    }
+
+    /// The servos that answered the last read — the ones a register write can be checked on.
+    fn present_ids(&self) -> Vec<u8> {
+        let s = self.shared.0.lock().unwrap();
+        JOINT_IDS
+            .iter()
+            .zip(&s.run)
+            .filter(|(_, run)| **run == 0)
+            .map(|(id, _)| *id)
+            .collect()
+    }
+
+    fn mapped_p(&self, kp: u16) -> u8 {
+        let p = f64::from(self.cfg.torque.p) * f64::from(kp) / f64::from(self.cfg.gain_ref.max(1));
+        p.round().clamp(1.0, 254.0) as u8
+    }
+
+    fn log_mismatch(m: &Mismatch, attempt: u32) {
+        let joint = JOINT_IDS
+            .iter()
+            .position(|&id| id == m.id)
+            .map_or("?", |i| JOINT_NAMES[i]);
+        tracing::warn!(id = m.id, joint, register = m.addr, wrote = m.wrote, read = ?m.read, attempt, "servo register reads back different; rewriting");
+    }
+
+    fn count_writes(&self, failed: &[Mismatch], rewrites: u64) {
+        let mut s = self.shared.0.lock().unwrap();
+        s.rewrites += rewrites;
+        s.write_failures += failed.len() as u64;
+        s.counters = self.bus.counters();
+    }
+
+    fn torque_off_all(&mut self) -> Result<()> {
+        let mut rewrites = 0u64;
+        let failed = feetech::torque_off(
+            &mut self.bus,
+            &JOINT_IDS,
+            self.cfg.torque.retries,
+            &mut |m, a| {
+                rewrites += 1;
+                Self::log_mismatch(m, a);
+            },
+        )
+        .map_err(|e| IoError::Bus(format!("torque off: {e}")))?;
+        self.count_writes(&failed, rewrites);
+        self.shared.0.lock().unwrap().torque = Some(false);
+        if failed.is_empty() {
+            Ok(())
+        } else {
+            Err(IoError::Bus(format!(
+                "torque off did not take: {}",
+                join(&failed)
+            )))
+        }
+    }
+}
+
+fn join(failed: &[Mismatch]) -> String {
+    failed
+        .iter()
+        .map(ToString::to_string)
+        .collect::<Vec<_>>()
+        .join("; ")
+}
+
+impl<P: Port> RobotIo for FeetechIo<P> {
+    fn read(&mut self) -> Result<Sensors> {
+        let started = Instant::now();
+        let period = self.read_started.map(|prev| started - prev);
+        self.read_started = Some(started);
+        self.tick += 1;
+        let with_temperature = self.cfg.temperature_every > 0
+            && self.tick % u64::from(self.cfg.temperature_every) == 1;
+        let len = if with_temperature { 8 } else { 7 };
+
+        let answers = self
+            .bus
+            .sync_read(&JOINT_IDS, reg::POSITION.0, len)
+            .map_err(|e| IoError::Bus(format!("tick sync_read: {e}")))?;
+
+        let mut v_min: Option<f64> = None;
+        let mut answered = 0usize;
+        let mut errors = [0u8; NUM_JOINTS];
+        let mut missed = [false; NUM_JOINTS];
+        for (j, a) in answers.iter().enumerate() {
+            let Some(s) = a else {
+                missed[j] = true;
+                continue;
+            };
+            answered += 1;
+            errors[j] = s.error;
+            let raw = feetech::from_le(&s.params[0..2]);
+            let sign = self.cfg.sign[j];
+            let p = counts_to_rad(raw, sign);
+            self.velocities[j] = match self.cfg.velocity {
+                VelocitySource::PositionDelta => match self.last_answer[j] {
+                    Some((p0, t0)) if started > t0 => (p - p0) / (started - t0).as_secs_f64(),
+                    _ => self.velocities[j],
+                },
+                VelocitySource::Register => {
+                    sign * f64::from(feetech::sign_magnitude(feetech::from_le(&s.params[2..4])))
+                        * self.cfg.speed_rad_per_count
+                }
+            };
+            self.positions[j] = p;
+            self.last_answer[j] = Some((p, started));
+            let v = f64::from(s.params[6]) * 0.1;
+            self.volts[j] = Some(v);
+            if v > 0.0 {
+                v_min = Some(v_min.map_or(v, |m: f64| m.min(v)));
+            }
+            if with_temperature {
+                self.temps[j] = Some(f64::from(s.params[7]));
+            }
+        }
+
+        if let Some(v) = v_min {
+            let a = self.cfg.voltage_alpha;
+            self.v_smoothed = Some(self.v_smoothed.map_or(v, |s| a * v + (1.0 - a) * s));
+            self.low_ticks = if v < self.cfg.cutoff_v {
+                self.low_ticks + 1
+            } else {
+                0
+            };
+        }
+        if self.low_ticks >= self.cfg.cutoff_ticks && !self.cutoff {
+            self.cutoff = true;
+            tracing::error!(
+                volts = ?v_min,
+                below = self.cfg.cutoff_v,
+                ticks = self.low_ticks,
+                "servo supply below the cutoff; torque off (robot.relax, then init, to bring it back)"
+            );
+            if let Err(e) = self.torque_off_all() {
+                tracing::error!(error = %e, "undervoltage torque-off did not take everywhere");
+            }
+        }
+
+        let sample = self.imu.latest();
+        let imu = sample.map_or_else(ImuData::default, |s| s.imu);
+        let imu_age = sample.map(|s| age(&s, started));
+        match (sample, self.imu_seq) {
+            (Some(s), Some(seq)) if s.seq == seq => {
+                self.imu_stale.total += 1;
+                self.imu_stale.run += 1;
+            }
+            _ => self.imu_stale.run = 0,
+        }
+        self.imu_seq = sample.map(|s| s.seq);
+
+        {
+            let mut s = self.shared.0.lock().unwrap();
+            s.ticks = self.tick;
+            if let Some(p) = period {
+                s.periods.push(p);
+            }
+            for j in 0..NUM_JOINTS {
+                if missed[j] {
+                    s.misses[j] += 1;
+                    s.run[j] += 1;
+                } else {
+                    if s.run[j] >= 50 {
+                        tracing::warn!(
+                            id = JOINT_IDS[j],
+                            joint = JOINT_NAMES[j],
+                            missed = s.run[j],
+                            "servo answers again; if it lost power its RAM registers are factory ones — relax, then init"
+                        );
+                    }
+                    s.run[j] = 0;
+                    s.errors[j] = errors[j];
+                }
+            }
+            s.volts = self.volts;
+            s.temps = self.temps;
+            s.v_smoothed = self.v_smoothed;
+            s.cutoff = self.cutoff;
+            s.counters = self.bus.counters();
+            s.imu_stale = self.imu_stale;
+            s.imu_age_last = imu_age;
+            if let Some(a) = imu_age {
+                s.imu_ages.push(a);
+            }
+        }
+
+        if answered == 0 {
+            return Err(IoError::ShortRead {
+                what: "servo answers",
+                expected: NUM_JOINTS,
+                got: 0,
+            });
+        }
+        Ok(Sensors {
+            positions: self.positions,
+            velocities: self.velocities,
+            currents_ma: [0.0; NUM_JOINTS],
+            imu,
+        })
+    }
+
+    fn write(&mut self, targets: &JointTargets) -> Result<()> {
+        // The servo's P loop pushes with a torque that follows its supply; multiplying the error
+        // by nominal / V holds that push where it was at the nominal voltage.
+        let k = match (self.cfg.voltage_adapt, self.v_smoothed) {
+            (true, Some(v)) => {
+                self.cfg.nominal_v / v.clamp(self.cfg.adapt_band.0, self.cfg.adapt_band.1)
+            }
+            _ => 1.0,
+        };
+        let mut bytes = Vec::with_capacity(NUM_JOINTS);
+        for (j, &id) in JOINT_IDS.iter().enumerate() {
+            let present = self.positions[j];
+            let goal = present + (targets.positions[j] - present) * k;
+            let raw = rad_to_counts(goal, self.cfg.sign[j]);
+            bytes.push((id, raw.to_le_bytes()));
+        }
+        let refs: Vec<(u8, &[u8])> = bytes.iter().map(|(id, b)| (*id, b.as_slice())).collect();
+        self.bus
+            .sync_write(reg::GOAL.0, reg::GOAL.1, &refs)
+            .map_err(|e| IoError::Bus(format!("sync_write goal: {e}")))?;
+        let obs_age = self.read_started.map(|t| t.elapsed());
+        if let Some(a) = obs_age {
+            let mut s = self.shared.0.lock().unwrap();
+            s.obs_ages.push(a);
+            s.adapt = k;
+        }
+        Ok(())
+    }
+
+    fn measures_load(&self) -> bool {
+        false
+    }
+
+    fn set_gain(&mut self, kp: u16) -> Result<()> {
+        let p = self.mapped_p(kp);
+        // Only the servos that answer: a silent one would cost every verification attempt a
+        // full timeout, and the tick with it. It gets its gain with the next torque-on.
+        let ids = self.present_ids();
+        let mut rewrites = 0u64;
+        let failed = feetech::write_verified(
+            &mut self.bus,
+            &ids,
+            reg::P,
+            &vec![u16::from(p); ids.len()],
+            self.cfg.torque.retries,
+            &mut |m, a| {
+                rewrites += 1;
+                Self::log_mismatch(m, a);
+            },
+        )
+        .map_err(|e| IoError::Bus(format!("P gain: {e}")))?
+        .into_iter()
+        .filter_map(std::result::Result::err)
+        .collect::<Vec<_>>();
+        self.count_writes(&failed, rewrites);
+        if failed.is_empty() {
+            self.kp = Some(kp);
+            Ok(())
+        } else {
+            Err(IoError::Bus(format!(
+                "P gain {p} did not take: {}",
+                join(&failed)
+            )))
+        }
+    }
+
+    fn set_torque(&mut self, on: bool) -> Result<()> {
+        if !on {
+            return self.torque_off_all();
+        }
+        let cfg = TorqueOn {
+            p: self.mapped_p(self.kp.unwrap_or(self.cfg.gain_ref)),
+            ..self.cfg.torque
+        };
+        let mut rewrites = 0u64;
+        let failed = feetech::torque_on(&mut self.bus, &JOINT_IDS, &cfg, &mut |m, a| {
+            rewrites += 1;
+            Self::log_mismatch(m, a);
+        })
+        .map_err(|e| IoError::Bus(format!("torque on: {e}")))?;
+        self.count_writes(&failed, rewrites);
+        if failed.is_empty() {
+            self.cutoff = false;
+            self.low_ticks = 0;
+            let mut s = self.shared.0.lock().unwrap();
+            s.torque = Some(true);
+            s.cutoff = false;
+            Ok(())
+        } else {
+            self.shared.0.lock().unwrap().torque = Some(false);
+            Err(IoError::Bus(format!(
+                "torque on did not take: {}",
+                join(&failed)
+            )))
+        }
+    }
+
+    fn reboot(&mut self, id: u8) -> Result<()> {
+        Err(IoError::Bus(format!(
+            "servo {id}: the Feetech driver (duck-brain P11) has no reboot; power-cycle the servo"
+        )))
+    }
+
+    /// The voltage and temperature the tick reads already brought — no bus traffic. Voltage is
+    /// the mean over the servos, as on the Dynamixel bus; a servo not read yet is left out.
+    fn slow_sensors(&mut self) -> Result<SlowSensors> {
+        let known: Vec<f64> = self
+            .volts
+            .iter()
+            .flatten()
+            .copied()
+            .filter(|v| *v > 0.0)
+            .collect();
+        if known.is_empty() {
+            return Err(IoError::ShortRead {
+                what: "servo voltage",
+                expected: NUM_JOINTS,
+                got: 0,
+            });
+        }
+        Ok(SlowSensors {
+            volts: known.iter().sum::<f64>() / known.len() as f64,
+            temps_c: self.temps.map(|t| t.unwrap_or(0.0)),
+        })
+    }
+
+    fn imu_stale(&self) -> ImuStale {
+        self.imu_stale
+    }
+
+    fn imu_ready(&self) -> bool {
+        self.imu.ready()
+    }
+
+    fn adapts_voltage(&self) -> bool {
+        self.cfg.voltage_adapt
+    }
+}
