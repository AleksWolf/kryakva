+    /// The gain maps onto P as a fraction of the configured one, and skips a silent servo.
+    #[test]
+    fn set_gain_writes_p_in_proportion() {
+        let mut io = io(Emulator::new(&JOINT_IDS), quick());
+        io.read().unwrap();
+        io.set_gain(200).unwrap();
+        assert_eq!(io.bus_mut().port_mut().servo(10).unwrap().get(50, 1), 32);
