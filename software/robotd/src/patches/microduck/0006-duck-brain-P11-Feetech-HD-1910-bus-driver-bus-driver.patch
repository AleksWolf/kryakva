diff --git a/feetech/src/emu.rs b/feetech/src/emu.rs
new file mode 100644
index 0000000..07c4700
--- /dev/null
+++ b/feetech/src/emu.rs
@@ -0,0 +1,176 @@
+//! Servos made of memory, for tests: a [`Port`] that answers the way the HD-1910 register map
+//! says a bus of them would. Not a model of the motor — a servo with torque on is simply at its
+//! goal — and nothing here claims timing.
+
+use std::collections::VecDeque;
+use std::io;
+use std::time::Duration;
+
+use crate::{BROADCAST, PING, Parser, Port, READ, SYNC_READ, SYNC_WRITE, WRITE, status};
+
+pub struct Servo {
+    pub id: u8,
+    pub regs: [u8; 256],
+    /// Answers nothing — unplugged, or a dead cable.
+    pub silent: bool,
+    /// Ignore this many writes before taking them: a servo that drops a write and has to be
+    /// told again.
+    pub ignore_writes: u32,
+    /// Never take a write to this register — a servo that will not, say, switch torque on.
+    pub refuse: Option<u8>,
+}
+
+impl Servo {
+    fn new(id: u8) -> Self {
+        let mut s = Self {
+            id,
+            regs: [0; 256],
+            silent: false,
+            ignore_writes: 0,
+            refuse: None,
+        };
+        s.set(56, 2, 2048);
+        s.set(42, 2, 2048);
+        s.set(62, 1, 74);
+        s.set(63, 1, 30);
+        s.set(50, 1, 32);
+        s.set(51, 1, 40);
+        s
+    }
+
+    pub fn get(&self, addr: u8, width: u8) -> u16 {
+        crate::from_le(&self.regs[usize::from(addr)..usize::from(addr) + usize::from(width)])
+    }
+
+    pub fn set(&mut self, addr: u8, width: u8, value: u16) {
+        let bytes = crate::le(value, width);
+        self.regs[usize::from(addr)..usize::from(addr) + bytes.len()].copy_from_slice(&bytes);
+    }
+
+    fn write(&mut self, addr: u8, data: &[u8]) {
+        if self.ignore_writes > 0 {
+            self.ignore_writes -= 1;
+            return;
+        }
+        if self.refuse == Some(addr) {
+            return;
+        }
+        let a = usize::from(addr);
+        self.regs[a..a + data.len()].copy_from_slice(data);
+        // Torque on: the servo is where it was told to be.
+        if self.regs[40] == 1 {
+            self.regs[56] = self.regs[42];
+            self.regs[57] = self.regs[43];
+        }
+    }
+}
+
+pub struct Emulator {
+    servos: Vec<Servo>,
+    out: VecDeque<u8>,
+    /// Hand every byte sent straight back first, as a half-duplex adapter may.
+    pub echo: bool,
+    parser: Parser,
+    /// Instructions seen, in order: (id, instruction, first parameter — the address).
+    pub log: Vec<(u8, u8, u8)>,
+}
+
+impl Emulator {
+    pub fn new(ids: &[u8]) -> Self {
+        Self {
+            servos: ids.iter().map(|&id| Servo::new(id)).collect(),
+            out: VecDeque::new(),
+            echo: false,
+            parser: Parser::default(),
+            log: Vec::new(),
+        }
+    }
+
+    pub fn servo_mut(&mut self, id: u8) -> Option<&mut Servo> {
+        self.servos.iter_mut().find(|s| s.id == id)
+    }
+
+    pub fn servo(&self, id: u8) -> Option<&Servo> {
+        self.servos.iter().find(|s| s.id == id)
+    }
+
+    fn live(&mut self, id: u8) -> Option<&mut Servo> {
+        self.servos.iter_mut().find(|s| s.id == id && !s.silent)
+    }
+
+    fn handle(&mut self, id: u8, instr: u8, params: &[u8]) {
+        self.log
+            .push((id, instr, params.first().copied().unwrap_or(0)));
+        match (instr, params) {
+            (PING, _) => {
+                if self.live(id).is_some() {
+                    self.out.extend(status(id, 0, &[]));
+                }
+            }
+            (READ, [addr, len]) => {
+                let (a, n) = (usize::from(*addr), usize::from(*len));
+                if let Some(s) = self.live(id) {
+                    let data = s.regs[a..a + n].to_vec();
+                    self.out.extend(status(id, 0, &data));
+                }
+            }
+            (WRITE, [addr, data @ ..]) => {
+                if let Some(s) = self.live(id) {
+                    s.write(*addr, data);
+                    self.out.extend(status(id, 0, &[]));
+                }
+            }
+            (SYNC_READ, [addr, len, ids @ ..]) if id == BROADCAST => {
+                let (a, n) = (usize::from(*addr), usize::from(*len));
+                for &target in ids {
+                    if let Some(s) = self.live(target) {
+                        let data = s.regs[a..a + n].to_vec();
+                        self.out.extend(status(target, 0, &data));
+                    }
+                }
+            }
+            (SYNC_WRITE, [addr, len, rest @ ..]) if id == BROADCAST => {
+                let chunk = 1 + usize::from(*len);
+                for entry in rest.chunks(chunk) {
+                    if entry.len() == chunk
+                        && let Some(s) = self.live(entry[0])
+                    {
+                        s.write(*addr, &entry[1..]);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+impl Port for Emulator {
+    fn send(&mut self, bytes: &[u8]) -> io::Result<()> {
+        if self.echo {
+            self.out.extend(bytes);
+        }
+        self.parser.push(bytes);
+        while let Some((packet, _)) = self.parser.next_packet() {
+            // Instruction packets parse as status packets with the instruction in `error`.
+            self.handle(packet.id, packet.error, &packet.params);
+        }
+        Ok(())
+    }
+
+    fn recv(&mut self, buf: &mut [u8], timeout: Duration) -> io::Result<usize> {
+        if self.out.is_empty() {
+            std::thread::sleep(timeout);
+            return Ok(0);
+        }
+        let n = buf.len().min(self.out.len());
+        for slot in buf.iter_mut().take(n) {
+            *slot = self.out.pop_front().expect("counted");
+        }
+        Ok(n)
+    }
+
+    fn discard_input(&mut self) -> io::Result<()> {
+        self.out.clear();
+        Ok(())
+    }
+}
diff --git a/feetech/src/lib.rs b/feetech/src/lib.rs
new file mode 100644
index 0000000..3367e29
--- /dev/null
+++ b/feetech/src/lib.rs
@@ -0,0 +1,751 @@
+//! Feetech STS/HLS servos on a half-duplex TTL bus — the duck-brain robot's HD-1910s
+//! (duck-brain patch P11).
+//!
+//! The framing is Feetech's "protocol v1", the Dynamixel 1.0 layout, checked against rustypot
+//! 1.8.0 (`src/dynamixel_protocol/v1.rs`):
+//!
+//! ```text
+//! instruction  FF FF id len instr params… chk    len = params + 2
+//! status       FF FF id len err   params… chk    chk = !(id + len + instr|err + Σ params)
+//! ```
+//!
+//! Multi-byte registers are little-endian. `SYNC_READ` (0x82) goes to the broadcast id with
+//! `[addr, len, id…]` and every listed servo answers with its own status packet; `SYNC_WRITE`
+//! (0x83) carries `[addr, len, (id, data…)…]` and nobody answers.
+//!
+//! Why not rustypot's controller, which speaks the same framing: its sync read gives up on the
+//! first servo that does not answer, and it has no way to drop the echo a half-duplex adapter
+//! can hand back. The control tick needs the opposite of both — every answer that did arrive,
+//! per servo, by a deadline — so the bus layer here is a streaming parser and a deadline.
+
+use std::io::{self, Read, Write};
+use std::time::{Duration, Instant};
+
+pub mod emu;
+
+/// The id every servo listens to.
+pub const BROADCAST: u8 = 0xFE;
+
+/// Instructions.
+pub const PING: u8 = 0x01;
+pub const READ: u8 = 0x02;
+pub const WRITE: u8 = 0x03;
+pub const SYNC_READ: u8 = 0x82;
+pub const SYNC_WRITE: u8 = 0x83;
+
+/// The HD-1910 registers the robot uses: address, width in bytes. From the duck-brain build's
+/// own register table (docs/patches/P11-feetech-driver.md), which agrees with rustypot's STS3215
+/// map for every address below except 50/51 (STS keeps P/D in EEPROM at 21/22; on the HD-1910
+/// they are RAM copies at 50/51).
+pub mod reg {
+    pub const TORQUE: (u8, u8) = (40, 1);
+    pub const ACCELERATION: (u8, u8) = (41, 1);
+    pub const GOAL: (u8, u8) = (42, 2);
+    pub const SPEED: (u8, u8) = (46, 2);
+    pub const TORQUE_LIMIT: (u8, u8) = (48, 2);
+    pub const P: (u8, u8) = (50, 1);
+    pub const D: (u8, u8) = (51, 1);
+    pub const POSITION: (u8, u8) = (56, 2);
+    pub const PRESENT_SPEED: (u8, u8) = (58, 2);
+    pub const VOLTAGE: (u8, u8) = (62, 1);
+    pub const TEMPERATURE: (u8, u8) = (63, 1);
+    pub const CURRENT: (u8, u8) = (69, 2);
+}
+
+/// Position counts per turn; 2048 is the joint's zero.
+pub const COUNTS_PER_TURN: f64 = 4096.0;
+pub const CENTER: f64 = 2048.0;
+
+/// `!(Σ bytes)` over id, length, instruction/error and parameters.
+pub fn checksum(body: &[u8]) -> u8 {
+    !body.iter().fold(0u8, |sum, b| sum.wrapping_add(*b))
+}
+
+/// One instruction packet.
+pub fn instruction(id: u8, instr: u8, params: &[u8]) -> Vec<u8> {
+    let mut p = Vec::with_capacity(params.len() + 6);
+    p.extend_from_slice(&[0xFF, 0xFF, id, (params.len() + 2) as u8, instr]);
+    p.extend_from_slice(params);
+    p.push(checksum(&p[2..]));
+    p
+}
+
+/// One status packet — what a servo sends back. Public for the emulator and the tests.
+pub fn status(id: u8, error: u8, params: &[u8]) -> Vec<u8> {
+    instruction(id, error, params)
+}
+
+/// Sign and magnitude in 16 bits, bit 15 the sign: how the servo reports speed and current
+/// (and position, should it ever go negative).
+pub fn sign_magnitude(raw: u16) -> i32 {
+    let magnitude = i32::from(raw & 0x7FFF);
+    if raw & 0x8000 != 0 {
+        -magnitude
+    } else {
+        magnitude
+    }
+}
+
+pub fn to_sign_magnitude(value: i32) -> u16 {
+    let magnitude = value.unsigned_abs().min(0x7FFF) as u16;
+    if value < 0 {
+        magnitude | 0x8000
+    } else {
+        magnitude
+    }
+}
+
+/// A status packet.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Status {
+    pub id: u8,
+    /// The servo's error byte; zero when all is well.
+    pub error: u8,
+    pub params: Vec<u8>,
+}
+
+/// Turns a byte stream into packets. Bytes before a header, and packets whose checksum fails,
+/// are dropped one header at a time, so a corrupted packet costs itself and nothing after it.
+#[derive(Debug, Default)]
+pub struct Parser {
+    buf: Vec<u8>,
+    /// Packets dropped for a bad checksum or an impossible length.
+    pub bad: u64,
+}
+
+impl Parser {
+    pub fn push(&mut self, bytes: &[u8]) {
+        self.buf.extend_from_slice(bytes);
+    }
+
+    pub fn clear(&mut self) {
+        self.buf.clear();
+    }
+
+    /// The next whole packet and its raw bytes, or `None` until more arrive.
+    pub fn next_packet(&mut self) -> Option<(Status, Vec<u8>)> {
+        loop {
+            let Some(start) = self.buf.windows(2).position(|w| w == [0xFF, 0xFF]) else {
+                // Keep a trailing 0xFF: it may be the first half of a header.
+                let keep = usize::from(self.buf.last() == Some(&0xFF));
+                let drop = self.buf.len() - keep;
+                self.buf.drain(..drop);
+                return None;
+            };
+            self.buf.drain(..start);
+            if self.buf.len() < 4 {
+                return None;
+            }
+            // `FF FF FF id`: an id is never 0xFF, so the header starts one byte later.
+            if self.buf[2] == 0xFF {
+                self.buf.drain(..1);
+                continue;
+            }
+            let len = usize::from(self.buf[3]);
+            if len < 2 {
+                self.bad += 1;
+                self.buf.drain(..2);
+                continue;
+            }
+            let total = 4 + len;
+            if self.buf.len() < total {
+                return None;
+            }
+            if checksum(&self.buf[2..total - 1]) != self.buf[total - 1] {
+                self.bad += 1;
+                self.buf.drain(..2);
+                continue;
+            }
+            let raw: Vec<u8> = self.buf.drain(..total).collect();
+            let status = Status {
+                id: raw[2],
+                error: raw[4],
+                params: raw[5..total - 1].to_vec(),
+            };
+            return Some((status, raw));
+        }
+    }
+}
+
+/// The byte pipe under [`Bus`]: a serial port on the robot, an emulator in tests.
+pub trait Port: Send {
+    fn send(&mut self, bytes: &[u8]) -> io::Result<()>;
+    /// Whatever has arrived, waiting at most `timeout` for the first byte. `Ok(0)` when nothing
+    /// came in time.
+    fn recv(&mut self, buf: &mut [u8], timeout: Duration) -> io::Result<usize>;
+    /// Forget anything not read yet: the tail of an earlier answer must not be parsed into this one.
+    fn discard_input(&mut self) -> io::Result<()>;
+}
+
+/// A tty, opened 8N1 at `baud`.
+pub struct SerialPort(Box<dyn serialport::SerialPort>);
+
+impl SerialPort {
+    pub fn open(path: &str, baud: u32) -> io::Result<Self> {
+        serialport::new(path, baud)
+            .timeout(Duration::from_millis(10))
+            .open()
+            .map(Self)
+            .map_err(io::Error::other)
+    }
+}
+
+impl Port for SerialPort {
+    fn send(&mut self, bytes: &[u8]) -> io::Result<()> {
+        self.0.write_all(bytes)
+    }
+
+    fn recv(&mut self, buf: &mut [u8], timeout: Duration) -> io::Result<usize> {
+        // On Linux this only stores the value; the read polls with it.
+        self.0
+            .set_timeout(timeout.max(Duration::from_micros(100)))
+            .map_err(io::Error::other)?;
+        match self.0.read(buf) {
+            Ok(n) => Ok(n),
+            Err(e) if e.kind() == io::ErrorKind::TimedOut => Ok(0),
+            Err(e) => Err(e),
+        }
+    }
+
+    fn discard_input(&mut self) -> io::Result<()> {
+        self.0
+            .clear(serialport::ClearBuffer::Input)
+            .map_err(io::Error::other)
+    }
+}
+
+/// Whether the adapter hands our own bytes back.
+///
+/// A half-duplex TTL bus has TX and RX on one wire, and whether the board's UART hears itself
+/// depends on how the wire is joined — not known for this robot (замерить: `robotctl servo
+/// table`, then `echoes` in its footer). `Auto` drops an answer byte-identical to the request
+/// once per transaction, and any packet from the broadcast id (only our own sync instructions
+/// carry it); `Off` takes every packet as an answer, which reads garbage if there is an echo.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Echo {
+    Auto,
+    Off,
+}
+
+/// What the bus has seen besides answers.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Counters {
+    /// Our own packets heard back.
+    pub echoes: u64,
+    /// Packets dropped for a bad checksum or an impossible length.
+    pub bad_packets: u64,
+    /// Valid packets from an id that was not asked, a second answer from one that was, or an
+    /// answer of the wrong length.
+    pub stray: u64,
+}
+
+/// A bus: one request, the answers that arrive by the deadline.
+pub struct Bus<P: Port> {
+    port: P,
+    parser: Parser,
+    /// How long a request waits for its answers (замерить; config `[feetech] read_timeout_ms`).
+    pub timeout: Duration,
+    pub echo: Echo,
+    counters: Counters,
+}
+
+impl<P: Port> Bus<P> {
+    pub fn new(port: P, timeout: Duration, echo: Echo) -> Self {
+        Self {
+            port,
+            parser: Parser::default(),
+            timeout,
+            echo,
+            counters: Counters::default(),
+        }
+    }
+
+    pub fn counters(&self) -> Counters {
+        Counters {
+            bad_packets: self.parser.bad,
+            ..self.counters
+        }
+    }
+
+    pub fn port_mut(&mut self) -> &mut P {
+        &mut self.port
+    }
+
+    fn transmit(&mut self, packet: &[u8]) -> io::Result<()> {
+        self.port.discard_input()?;
+        self.parser.clear();
+        self.port.send(packet)
+    }
+
+    /// Answers from `ids`, each at most once, until all have answered or `deadline` passes.
+    fn collect(
+        &mut self,
+        sent: &[u8],
+        ids: &[u8],
+        len: Option<usize>,
+        deadline: Instant,
+    ) -> io::Result<Vec<Option<Status>>> {
+        let mut out: Vec<Option<Status>> = vec![None; ids.len()];
+        let mut left = ids.len();
+        let mut echo_pending = self.echo == Echo::Auto;
+        let mut buf = [0u8; 1024];
+        loop {
+            while let Some((status, raw)) = self.parser.next_packet() {
+                if self.echo == Echo::Auto
+                    && (status.id == BROADCAST || (echo_pending && raw == sent))
+                {
+                    echo_pending = echo_pending && raw != sent;
+                    self.counters.echoes += 1;
+                    continue;
+                }
+                match ids.iter().position(|&id| id == status.id) {
+                    Some(k) if out[k].is_none() && len.is_none_or(|n| status.params.len() == n) => {
+                        out[k] = Some(status);
+                        left -= 1;
+                    }
+                    _ => self.counters.stray += 1,
+                }
+            }
+            if left == 0 {
+                break;
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                break;
+            }
+            let n = self.port.recv(&mut buf, deadline - now)?;
+            if n == 0 && Instant::now() >= deadline {
+                break;
+            }
+            self.parser.push(&buf[..n]);
+        }
+        Ok(out)
+    }
+
+    pub fn ping(&mut self, id: u8) -> io::Result<bool> {
+        let p = instruction(id, PING, &[]);
+        self.transmit(&p)?;
+        let deadline = Instant::now() + self.timeout;
+        Ok(self.collect(&p, &[id], Some(0), deadline)?[0].is_some())
+    }
+
+    /// `len` bytes from `addr` of one servo, or `None` when it did not answer.
+    pub fn read(&mut self, id: u8, addr: u8, len: u8) -> io::Result<Option<Status>> {
+        let p = instruction(id, READ, &[addr, len]);
+        self.transmit(&p)?;
+        let deadline = Instant::now() + self.timeout;
+        Ok(self
+            .collect(&p, &[id], Some(usize::from(len)), deadline)?
+            .remove(0))
+    }
+
+    /// Write `data` at `addr` of one servo, waiting for its acknowledgement, which a servo set
+    /// not to acknowledge writes never sends — so `None` is not a failure on its own.
+    pub fn write(&mut self, id: u8, addr: u8, data: &[u8]) -> io::Result<Option<Status>> {
+        let mut params = vec![addr];
+        params.extend_from_slice(data);
+        let p = instruction(id, WRITE, &params);
+        self.transmit(&p)?;
+        let deadline = Instant::now() + self.timeout;
+        Ok(self.collect(&p, &[id], Some(0), deadline)?.remove(0))
+    }
+
+    /// `len` bytes from `addr` of every servo in `ids`, one entry per id, `None` for a servo that
+    /// did not answer in time.
+    pub fn sync_read(&mut self, ids: &[u8], addr: u8, len: u8) -> io::Result<Vec<Option<Status>>> {
+        let mut params = vec![addr, len];
+        params.extend_from_slice(ids);
+        let p = instruction(BROADCAST, SYNC_READ, &params);
+        self.transmit(&p)?;
+        let deadline = Instant::now() + self.timeout;
+        self.collect(&p, ids, Some(usize::from(len)), deadline)
+    }
+
+    /// The same `len` bytes at `addr` of each servo, one value per servo; nobody answers.
+    pub fn sync_write(&mut self, addr: u8, len: u8, data: &[(u8, &[u8])]) -> io::Result<()> {
+        let mut params = Vec::with_capacity(2 + data.len() * (1 + usize::from(len)));
+        params.extend_from_slice(&[addr, len]);
+        for (id, bytes) in data {
+            debug_assert_eq!(bytes.len(), usize::from(len));
+            params.push(*id);
+            params.extend_from_slice(bytes);
+        }
+        let p = instruction(BROADCAST, SYNC_WRITE, &params);
+        self.transmit(&p)
+    }
+}
+
+/// A register value as bytes, little-endian, `width` 1 or 2.
+pub fn le(value: u16, width: u8) -> Vec<u8> {
+    match width {
+        1 => vec![value as u8],
+        _ => value.to_le_bytes().to_vec(),
+    }
+}
+
+/// Bytes back to a value, little-endian.
+pub fn from_le(bytes: &[u8]) -> u16 {
+    match bytes {
+        [b] => u16::from(*b),
+        [lo, hi, ..] => u16::from_le_bytes([*lo, *hi]),
+        [] => 0,
+    }
+}
+
+/// Write one register on every servo in `ids` and read it back, rewriting the servos that read
+/// back different, up to `retries` more times. Returns, per id, how many rewrites it took, or
+/// `Err` per id that never read back right (or never answered).
+///
+/// A sync write then a sync read: two transactions however many servos, which is what keeps the
+/// torque-on sequence short enough to run inside one control tick.
+///
+/// `on_mismatch` sees every read-back that disagreed, with the attempt it happened on (0 for
+/// the first write) — for the journal.
+pub fn write_verified<P: Port>(
+    bus: &mut Bus<P>,
+    ids: &[u8],
+    (addr, width): (u8, u8),
+    values: &[u16],
+    retries: u32,
+    on_mismatch: &mut dyn FnMut(&Mismatch, u32),
+) -> io::Result<Vec<Result<u32, Mismatch>>> {
+    let mut result: Vec<Result<u32, Mismatch>> = ids.iter().map(|_| Ok(0)).collect();
+    let mut pending: Vec<usize> = (0..ids.len()).collect();
+    for attempt in 0..=retries {
+        let bytes: Vec<(u8, Vec<u8>)> = pending
+            .iter()
+            .map(|&k| (ids[k], le(values[k], width)))
+            .collect();
+        let refs: Vec<(u8, &[u8])> = bytes.iter().map(|(id, b)| (*id, b.as_slice())).collect();
+        bus.sync_write(addr, width, &refs)?;
+        let asked: Vec<u8> = pending.iter().map(|&k| ids[k]).collect();
+        let back = bus.sync_read(&asked, addr, width)?;
+        let mut still = Vec::new();
+        for (slot, &k) in pending.iter().enumerate() {
+            let got = back[slot].as_ref().map(|s| from_le(&s.params));
+            if got == Some(values[k]) {
+                result[k] = Ok(attempt);
+            } else {
+                let m = Mismatch {
+                    id: ids[k],
+                    addr,
+                    wrote: values[k],
+                    read: got,
+                };
+                on_mismatch(&m, attempt);
+                result[k] = Err(m);
+                still.push(k);
+            }
+        }
+        pending = still;
+        if pending.is_empty() {
+            break;
+        }
+    }
+    Ok(result)
+}
+
+/// A register that did not read back what was written.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Mismatch {
+    pub id: u8,
+    pub addr: u8,
+    pub wrote: u16,
+    /// `None` when the servo did not answer the read at all.
+    pub read: Option<u16>,
+}
+
+impl std::fmt::Display for Mismatch {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self.read {
+            Some(v) => write!(
+                f,
+                "id {} reg {}: wrote {}, reads {}",
+                self.id, self.addr, self.wrote, v
+            ),
+            None => write!(f, "id {} reg {}: no answer", self.id, self.addr),
+        }
+    }
+}
+
+/// The values the torque-on sequence writes (config `[feetech]`).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct TorqueOn {
+    /// RAM 50 and 51.
+    pub p: u8,
+    pub d: u8,
+    /// 48. 1000 by the duck-brain measurements of 13–14.10.2026.
+    pub torque_limit: u16,
+    /// 46. 10000; 0 means "stop", not "unlimited".
+    pub speed: u16,
+    /// Rewrites after a read-back that disagrees.
+    pub retries: u32,
+}
+
+/// Torque on, the duck-brain way (measurements of 13–14.10.2026), on every servo in `ids`:
+///
+/// 0. goal (42) = present position (56), so torque coming on moves nothing;
+/// 1. P (50) and D (51), RAM;
+/// 2. torque limit (48), then speed (46);
+/// 3. torque (40) = 1;
+/// 4. acceleration (41) = 1, then 0 — *under* torque: written with torque off, some servos keep
+///    the old profile and travel on it for 0.3 s.
+///
+/// Every write is read back and rewritten up to `retries` times. A step that still disagrees
+/// stops the sequence; if torque was already on by then it is taken off again, so the caller's
+/// "it failed" and the servos agree. Returns what never read back right — empty is success.
+pub fn torque_on<P: Port>(
+    bus: &mut Bus<P>,
+    ids: &[u8],
+    cfg: &TorqueOn,
+    on_mismatch: &mut dyn FnMut(&Mismatch, u32),
+) -> io::Result<Vec<Mismatch>> {
+    let present = bus.sync_read(ids, reg::POSITION.0, reg::POSITION.1)?;
+    let mut failed: Vec<Mismatch> = ids
+        .iter()
+        .zip(&present)
+        .filter(|(_, s)| s.is_none())
+        .map(|(&id, _)| Mismatch {
+            id,
+            addr: reg::POSITION.0,
+            wrote: 0,
+            read: None,
+        })
+        .collect();
+    if !failed.is_empty() {
+        return Ok(failed);
+    }
+    let goals: Vec<u16> = present
+        .iter()
+        .map(|s| from_le(&s.as_ref().expect("checked above").params))
+        .collect();
+    let all = |v: u16| vec![v; ids.len()];
+    let steps: [((u8, u8), Vec<u16>); 8] = [
+        (reg::GOAL, goals),
+        (reg::P, all(u16::from(cfg.p))),
+        (reg::D, all(u16::from(cfg.d))),
+        (reg::TORQUE_LIMIT, all(cfg.torque_limit)),
+        (reg::SPEED, all(cfg.speed)),
+        (reg::TORQUE, all(1)),
+        (reg::ACCELERATION, all(1)),
+        (reg::ACCELERATION, all(0)),
+    ];
+    let mut torque_written = false;
+    for (register, values) in steps {
+        torque_written |= register == reg::TORQUE;
+        let result = write_verified(bus, ids, register, &values, cfg.retries, on_mismatch)?;
+        failed = result.into_iter().filter_map(Result::err).collect();
+        if !failed.is_empty() {
+            if torque_written {
+                // Some servos may have torque by now; leave every one of them off.
+                let _ = write_verified(bus, ids, reg::TORQUE, &all(0), cfg.retries, &mut |_, _| {});
+            }
+            return Ok(failed);
+        }
+    }
+    Ok(failed)
+}
+
+/// Torque off (40 = 0) on every servo in `ids`, read back like any other write. Nothing else is
+/// touched: the RAM registers go back to factory values when the servo loses power anyway.
+pub fn torque_off<P: Port>(
+    bus: &mut Bus<P>,
+    ids: &[u8],
+    retries: u32,
+    on_mismatch: &mut dyn FnMut(&Mismatch, u32),
+) -> io::Result<Vec<Mismatch>> {
+    let result = write_verified(
+        bus,
+        ids,
+        reg::TORQUE,
+        &vec![0; ids.len()],
+        retries,
+        on_mismatch,
+    )?;
+    Ok(result.into_iter().filter_map(Result::err).collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use emu::Emulator;
+
+    /// rustypot's v1 framing, by hand: a PING to id 1 is FF FF 01 02 01 FB.
+    #[test]
+    fn packets_frame_like_protocol_v1() {
+        assert_eq!(
+            instruction(1, PING, &[]),
+            vec![0xFF, 0xFF, 0x01, 0x02, 0x01, 0xFB]
+        );
+        // READ id 1, addr 56, 2 bytes.
+        let p = instruction(1, READ, &[56, 2]);
+        assert_eq!(p[3], 4);
+        assert_eq!(p[7], !(1u8 + 4 + 2 + 56 + 2));
+    }
+
+    #[test]
+    fn the_parser_resyncs_past_garbage_and_bad_checksums() {
+        let mut parser = Parser::default();
+        let good = status(12, 0, &[1, 2]);
+        let mut bad = status(13, 0, &[3, 4]);
+        *bad.last_mut().unwrap() ^= 0x55;
+        parser.push(&[0x00, 0xFF, 0x13]);
+        parser.push(&bad);
+        parser.push(&[0xFF]);
+        parser.push(&good[..3]);
+        assert!(
+            parser.next_packet().is_none(),
+            "half a packet is not a packet"
+        );
+        parser.push(&good[3..]);
+        let (s, raw) = parser.next_packet().expect("the good packet");
+        assert_eq!((s.id, s.params.as_slice()), (12, &[1u8, 2][..]));
+        assert_eq!(raw, good);
+        assert_eq!(parser.bad, 1);
+    }
+
+    #[test]
+    fn sign_magnitude_round_trips() {
+        for v in [-32767, -1, 0, 1, 300, 32767] {
+            assert_eq!(sign_magnitude(to_sign_magnitude(v)), v);
+        }
+        assert_eq!(sign_magnitude(0x8000 | 5), -5);
+    }
+
+    fn bus(emu: Emulator) -> Bus<Emulator> {
+        Bus::new(emu, Duration::from_millis(5), Echo::Auto)
+    }
+
+    /// One servo silent: the others still answer, in their slots, and the call does not fail.
+    #[test]
+    fn a_silent_servo_is_a_none_not_an_error() {
+        let mut emu = Emulator::new(&[10, 11, 12]);
+        emu.servo_mut(11).unwrap().silent = true;
+        let mut b = bus(emu);
+        let got = b.sync_read(&[10, 11, 12], 56, 7).unwrap();
+        assert!(got[0].is_some() && got[1].is_none() && got[2].is_some());
+        assert_eq!(got[2].as_ref().unwrap().params.len(), 7);
+    }
+
+    /// With an echoing adapter, `Auto` drops our own packet and still reads the answer; a
+    /// unicast READ's echo would otherwise parse as an answer from that very servo.
+    #[test]
+    fn auto_echo_drops_our_own_packet() {
+        let mut emu = Emulator::new(&[12]);
+        emu.echo = true;
+        emu.servo_mut(12).unwrap().set(56, 2, 3000);
+        let mut b = bus(emu);
+        let s = b.read(12, 56, 2).unwrap().expect("answer");
+        assert_eq!(from_le(&s.params), 3000);
+        b.sync_write(42, 2, &[(12, &[0, 8])]).unwrap();
+        assert_eq!(
+            b.sync_read(&[12], 56, 2).unwrap()[0]
+                .as_ref()
+                .map(|s| s.params.len()),
+            Some(2)
+        );
+        assert!(b.counters().echoes >= 2, "{:?}", b.counters());
+    }
+
+    /// A write a servo ignores the first time is retried, and the retry is counted.
+    #[test]
+    fn writes_are_verified_and_retried() {
+        let mut emu = Emulator::new(&[10, 11]);
+        emu.servo_mut(11).unwrap().ignore_writes = 2;
+        let mut b = bus(emu);
+        let mut seen = Vec::new();
+        let r = write_verified(&mut b, &[10, 11], reg::P, &[20, 20], 5, &mut |m, a| {
+            seen.push((m.id, a))
+        })
+        .unwrap();
+        assert_eq!(r, vec![Ok(0), Ok(2)]);
+        assert_eq!(
+            seen,
+            vec![(11, 0), (11, 1)],
+            "each disagreeing read-back is reported"
+        );
+        let mut emu = Emulator::new(&[10]);
+        emu.servo_mut(10).unwrap().ignore_writes = 99;
+        let mut b = bus(emu);
+        let r = write_verified(&mut b, &[10], reg::P, &[20], 5, &mut |_, _| {}).unwrap();
+        assert!(matches!(
+            r[0],
+            Err(Mismatch {
+                id: 10,
+                addr: 50,
+                wrote: 20,
+                read: Some(32)
+            })
+        ));
+    }
+
+    const TORQUE: TorqueOn = TorqueOn {
+        p: 32,
+        d: 40,
+        torque_limit: 1000,
+        speed: 10000,
+        retries: 5,
+    };
+
+    /// The order of the duck-brain measurements, and 41 written only once torque is on.
+    #[test]
+    fn torque_on_writes_the_sequence_in_order_and_holds_the_present_position() {
+        let mut emu = Emulator::new(&[12, 13]);
+        emu.servo_mut(12).unwrap().set(56, 2, 2500);
+        emu.servo_mut(12).unwrap().set(42, 2, 1000); // a stale goal from before
+        let mut b = bus(emu);
+        let failed = torque_on(&mut b, &[12, 13], &TORQUE, &mut |_, _| {}).unwrap();
+        assert!(failed.is_empty(), "{failed:?}");
+        let emu = b.port_mut();
+        let s = emu.servo(12).unwrap();
+        assert_eq!(s.get(42, 2), 2500, "goal = present before torque");
+        assert_eq!(s.get(56, 2), 2500, "and so nothing moved");
+        assert_eq!(
+            (s.get(50, 1), s.get(51, 1), s.get(48, 2), s.get(46, 2)),
+            (32, 40, 1000, 10000)
+        );
+        assert_eq!((s.get(40, 1), s.get(41, 1)), (1, 0));
+        // The sync writes, by register, in order, none repeated.
+        let order: Vec<u8> = emu
+            .log
+            .iter()
+            .filter(|(_, i, _)| *i == SYNC_WRITE)
+            .map(|(_, _, addr)| *addr)
+            .collect();
+        assert_eq!(order, vec![42, 50, 51, 48, 46, 40, 41, 41]);
+    }
+
+    /// A servo that will not take torque leaves the whole set off.
+    #[test]
+    fn a_failed_torque_write_leaves_every_servo_off() {
+        let mut emu = Emulator::new(&[12, 13]);
+        emu.servo_mut(13).unwrap().refuse = Some(40);
+        let mut b = bus(emu);
+        let mut retries = 0;
+        let failed = torque_on(&mut b, &[12, 13], &TORQUE, &mut |m, _| {
+            if m.addr == 40 {
+                retries += 1;
+            }
+        })
+        .unwrap();
+        assert_eq!(failed.len(), 1);
+        assert_eq!((failed[0].id, failed[0].addr), (13, 40));
+        assert_eq!(retries, 6, "the first write and five rewrites");
+        assert_eq!(
+            b.port_mut().servo(12).unwrap().get(40, 1),
+            0,
+            "12 is off again"
+        );
+    }
+
+    /// A silent servo is reported, and nothing is switched on.
+    #[test]
+    fn torque_on_with_a_silent_servo_switches_nothing_on() {
+        let mut emu = Emulator::new(&[12, 13]);
+        emu.servo_mut(13).unwrap().silent = true;
+        let mut b = bus(emu);
+        let failed = torque_on(&mut b, &[12, 13], &TORQUE, &mut |_, _| {}).unwrap();
+        assert_eq!(failed.iter().map(|m| m.id).collect::<Vec<_>>(), vec![13]);
+        assert_eq!(b.port_mut().servo(12).unwrap().get(40, 1), 0);
+    }
+}
