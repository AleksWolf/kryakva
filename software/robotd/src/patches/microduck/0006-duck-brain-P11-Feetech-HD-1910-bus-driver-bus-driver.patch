@@ -0,0 +1,284 @@
+//! `robotctl servo` — the Feetech HD-1910 bus, straight through the serial port (duck-brain P11).
+//!
+//! A bench tool for the duck-brain robot: read and write a register by id, torque on or off, and
+//! a table of position, voltage, temperature and current for every joint. It opens the port
+//! itself, so robotd has to be stopped first (`sudo systemctl stop robotd`); the tty is opened
+//! exclusively, and a running robotd shows up here as "busy".
+//!
+//! Torque on is the same verified sequence robotd runs (`feetech::torque_on`), so a servo
+//! brought up by hand is brought up the way the daemon would.
+
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use clap::Subcommand;
+use feetech::{Bus, Echo, SerialPort, reg};
+use robotd_params::{FeetechEcho, Params};
+
+use super::{Failure, exit};
+
+type Result<T> = std::result::Result<T, Failure>;
+
+/// The joints in robotd's order, with their ids — the same table as `duck_ipc_proto`.
+fn joints() -> impl Iterator<Item = (u8, &'static str)> {
+    duck_ipc_proto::JOINT_IDS
+        .into_iter()
+        .zip(duck_ipc_proto::JOINT_NAMES)
+}
+
+#[derive(Subcommand, Debug)]
+pub(super) enum ServoCommand {
+    /// Position (56), voltage (62), temperature (63) and current (69) of every joint.
+    Table,
+    /// Which joint ids answer a ping.
+    Ping,
+    /// Read a register: `robotctl servo read 12 56` (width from the register table, or --len).
+    Read {
+        id: u8,
+        addr: u8,
+        #[arg(long)]
+        len: Option<u8>,
+    },
+    /// Write a register and read it back. RAM only (40 and up) unless --eeprom.
+    Write {
+        id: u8,
+        addr: u8,
+        value: u16,
+        #[arg(long)]
+        len: Option<u8>,
+        /// Allow an address below 40, the EEPROM. robotd never writes there; offsets and ids are
+        /// set when a servo is calibrated.
+        #[arg(long)]
+        eeprom: bool,
+    },
+    /// Torque on or off, for one id or `all`. On is robotd's verified sequence: goal = present,
+    /// P/D, torque limit, speed, torque, acceleration 1 then 0.
+    Torque {
+        /// A joint id, or `all`.
+        target: String,
+        /// `on` or `off`.
+        state: String,
+    },
+}
+
+/// Global options for the bus, read from robotd.toml unless given.
+#[derive(clap::Args, Debug)]
+pub(super) struct BusArgs {
+    /// robotd.toml to take the port, line rate and torque values from.
+    #[arg(long, default_value = robotd_params::DEFAULT_PATH)]
+    pub params: PathBuf,
+    /// Serial port, overriding `[bus] port`.
+    #[arg(long)]
+    pub port: Option<String>,
+}
+
+/// Width of a register this robot uses, or 1.
+fn width(addr: u8) -> u8 {
+    [
+        reg::TORQUE,
+        reg::ACCELERATION,
+        reg::GOAL,
+        reg::SPEED,
+        reg::TORQUE_LIMIT,
+        reg::P,
+        reg::D,
+        reg::POSITION,
+        reg::PRESENT_SPEED,
+        reg::VOLTAGE,
+        reg::TEMPERATURE,
+        reg::CURRENT,
+    ]
+    .iter()
+    .find(|(a, _)| *a == addr)
+    .map_or(1, |(_, w)| *w)
+}
+
+fn params(path: &Path) -> Result<Params> {
+    // An absent default file is an unprovisioned board: defaults. A broken one is an error, and
+    // the error already names the file.
+    Params::load(path, path != Path::new(robotd_params::DEFAULT_PATH))
+        .map_err(|e| Failure::new(exit::FAILED, e.to_string()))
+}
+
+fn open(p: &Params, port: &str) -> Result<Bus<SerialPort>> {
+    let serial = SerialPort::open(port, p.feetech.baud).map_err(|e| {
+        if std::path::Path::new(port).exists() {
+            Failure::new(
+                exit::BUSY,
+                format!("{port}: {e} — is robotd running? sudo systemctl stop robotd"),
+            )
+        } else {
+            Failure::new(
+                exit::FAILED,
+                format!("{port}: no such port — is UART2 enabled (overlay uart2-m0)?"),
+            )
+        }
+    })?;
+    let echo = match p.feetech.echo {
+        FeetechEcho::Auto => Echo::Auto,
+        FeetechEcho::Off => Echo::Off,
+    };
+    Ok(Bus::new(
+        serial,
+        Duration::from_secs_f64(p.feetech.read_timeout_ms / 1000.0),
+        echo,
+    ))
+}
+
+fn io_err(e: std::io::Error) -> Failure {
+    Failure::new(exit::FAILED, format!("bus: {e}"))
+}
+
+pub(super) fn run(args: &BusArgs, command: ServoCommand) -> Result<()> {
+    let p = params(&args.params)?;
+    let port = args.port.clone().unwrap_or_else(|| p.bus.port.clone());
+    let mut bus = open(&p, &port)?;
+    let signs = p.feetech.sign.to_array();
+    match command {
+        ServoCommand::Table => {
+            let ids: Vec<u8> = joints().map(|(id, _)| id).collect();
+            // 56..70: position, speed, load, voltage, temperature, …, current at 69.
+            let rows = bus.sync_read(&ids, 56, 15).map_err(io_err)?;
+            println!(" id  joint             pos   rad(sign)    V     °C   current  err");
+            for (k, (id, name)) in joints().enumerate() {
+                match &rows[k] {
+                    Some(s) => {
+                        let b = &s.params;
+                        let pos = feetech::from_le(&b[0..2]);
+                        let rad = f64::from(signs[k])
+                            * (f64::from(feetech::sign_magnitude(pos)) - feetech::CENTER)
+                            * std::f64::consts::TAU
+                            / feetech::COUNTS_PER_TURN;
+                        let current = feetech::sign_magnitude(feetech::from_le(&b[13..15]));
+                        println!(
+                            "{id:>3}  {name:<16} {pos:>4}  {rad:>+8.3}   {:>4.1}  {:>4}  {current:>7}  {:#04x}",
+                            f64::from(b[6]) * 0.1,
+                            b[7],
+                            s.error
+                        );
+                    }
+                    None => println!("{id:>3}  {name:<16}    — no answer"),
+                }
+            }
+            let c = bus.counters();
+            println!(
+                "voltage is register 62 as read (the servos read ~0.7 V low); current in servo units\n\
+                 echoes {}  bad packets {}  stray {}",
+                c.echoes, c.bad_packets, c.stray
+            );
+        }
+        ServoCommand::Ping => {
+            for (id, name) in joints() {
+                let ok = bus.ping(id).map_err(io_err)?;
+                println!(
+                    "{id:>3}  {name:<16} {}",
+                    if ok { "answers" } else { "— no answer" }
+                );
+            }
+        }
+        ServoCommand::Read { id, addr, len } => {
+            let len = len.unwrap_or_else(|| width(addr));
+            match bus.read(id, addr, len).map_err(io_err)? {
+                Some(s) => {
+                    let v = feetech::from_le(&s.params);
+                    println!(
+                        "id {id} reg {addr} = {v} ({:#06x}; signed by bit 15: {})  err {:#04x}",
+                        v,
+                        feetech::sign_magnitude(v),
+                        s.error
+                    );
+                }
+                None => return Err(Failure::new(exit::FAILED, format!("id {id}: no answer"))),
+            }
+        }
+        ServoCommand::Write {
+            id,
+            addr,
+            value,
+            len,
+            eeprom,
+        } => {
+            if addr < 40 && !eeprom {
+                return Err(Failure::new(
+                    exit::USAGE,
+                    format!(
+                        "reg {addr} is EEPROM; robotd never writes there — add --eeprom if you mean it"
+                    ),
+                ));
+            }
+            let len = len.unwrap_or_else(|| width(addr));
+            let r = feetech::write_verified(
+                &mut bus,
+                &[id],
+                (addr, len),
+                &[value],
+                p.feetech.write_retries,
+                &mut |m, a| {
+                    eprintln!("attempt {a}: {m}");
+                },
+            )
+            .map_err(io_err)?;
+            match &r[0] {
+                Ok(0) => println!("id {id} reg {addr} = {value}, read back"),
+                Ok(n) => println!("id {id} reg {addr} = {value}, read back after {n} rewrite(s)"),
+                Err(m) => return Err(Failure::new(exit::FAILED, m.to_string())),
+            }
+        }
+        ServoCommand::Torque { target, state } => {
+            let ids: Vec<u8> = if target == "all" {
+                joints().map(|(id, _)| id).collect()
+            } else {
+                vec![target.parse().map_err(|_| {
+                    Failure::new(exit::USAGE, format!("{target:?}: a joint id or `all`"))
+                })?]
+            };
+            let on = match state.as_str() {
+                "on" => true,
+                "off" => false,
+                other => {
+                    return Err(Failure::new(
+                        exit::USAGE,
+                        format!("{other:?}: `on` or `off`"),
+                    ));
+                }
+            };
+            let mut report = |m: &feetech::Mismatch, a: u32| eprintln!("attempt {a}: {m}");
+            let failed = if on {
+                let cfg = feetech::TorqueOn {
+                    p: p.feetech.p,
+                    d: p.feetech.d,
+                    torque_limit: p.feetech.torque_limit,
+                    speed: p.feetech.speed,
+                    retries: p.feetech.write_retries,
+                };
+                feetech::torque_on(&mut bus, &ids, &cfg, &mut report)
+            } else {
+                feetech::torque_off(&mut bus, &ids, p.feetech.write_retries, &mut report)
+            }
+            .map_err(io_err)?;
+            if failed.is_empty() {
+                println!("torque {}: {ids:?}", if on { "on" } else { "off" });
+            } else {
+                let what: Vec<String> = failed.iter().map(ToString::to_string).collect();
+                return Err(Failure::new(
+                    exit::FAILED,
+                    format!("did not take: {}", what.join("; ")),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn widths_follow_the_register_table() {
+        assert_eq!(width(42), 2);
+        assert_eq!(width(40), 1);
+        assert_eq!(width(69), 2);
+        assert_eq!(width(5), 1);
+    }
+}
