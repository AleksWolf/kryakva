+    /// Torque on goes through the verified sequence and holds the present pose.
+    #[test]
+    fn torque_on_holds_the_present_pose() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(13).unwrap().set(56, 2, 2600);
+        let mut io = io(emu, quick());
+        io.set_torque(true).unwrap();
+        let s = io.bus_mut().port_mut().servo(13).unwrap();
+        assert_eq!(
+            (s.get(42, 2), s.get(40, 1), s.get(41, 1), s.get(50, 1)),
+            (2600, 1, 0, 32)
+        );
+        assert_eq!(io.shared().snapshot().torque, Some(true));
+    }
+}
diff --git a/duck-control/src/host_imu.rs b/duck-control/src/host_imu.rs
new file mode 100644
index 0000000..e9bad7c
--- /dev/null
+++ b/duck-control/src/host_imu.rs
@@ -0,0 +1,114 @@
+//! The body IMU read by the host rather than fetched over the servo bus (duck-brain patch P12).
+//!
+//! On the duck-brain robot the LSM6DSV16X sits on the Zero 3W's own I²C bus, not on an
+//! `imu_to_dxl` board, so the tick cannot get orientation in the same transaction as the joints.
+//! A reader thread (`robotd`'s `body_imu`, P12) polls the chip and publishes here; the bus driver
+//! (P11) takes the newest sample at the start of each tick, together with how old it is.
+
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+
+use crate::imu::ImuData;
+
+/// One decoded sample and when the chip produced it.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct HostSample {
+    pub imu: ImuData,
+    pub at: Instant,
+    /// Counts samples since the reader started; a tick that sees the same number twice got no
+    /// new sample.
+    pub seq: u64,
+}
+
+/// What the reader says about itself, for `robot.health`.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct ReaderStatus {
+    /// `"/dev/i2c-3 0x6a"` once the chip answered and configured.
+    pub device: Option<String>,
+    /// Why there is no chip, or the last read error.
+    pub error: Option<String>,
+    /// FIFO polls and decoded samples since the reader started.
+    pub polls: u64,
+    pub samples: u64,
+    pub started: Option<Instant>,
+}
+
+/// The hand-off between the reader thread and the bus driver.
+#[derive(Default)]
+pub struct ImuFeed {
+    latest: Mutex<Option<HostSample>>,
+    ready: AtomicBool,
+    status: Mutex<ReaderStatus>,
+    /// A constant upright sample, always fresh — `robotd --static-imu`, for running the loop on
+    /// a bench with no IMU (the x86 servo-emulator check). Never on a robot that stands.
+    fixed: bool,
+}
+
+impl ImuFeed {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// See [`Self::fixed`].
+    pub fn static_upright() -> Self {
+        Self {
+            fixed: true,
+            ready: AtomicBool::new(true),
+            ..Self::default()
+        }
+    }
+
+    pub fn is_static(&self) -> bool {
+        self.fixed
+    }
+
+    pub fn publish(&self, sample: HostSample, ready: bool) {
+        *self.latest.lock().unwrap() = Some(sample);
+        self.ready.store(ready, Ordering::Relaxed);
+    }
+
+    /// The newest sample, or `None` before the first one.
+    pub fn latest(&self) -> Option<HostSample> {
+        if self.fixed {
+            static SEQ: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+            return Some(HostSample {
+                imu: ImuData::default(),
+                at: Instant::now(),
+                seq: SEQ.fetch_add(1, Ordering::Relaxed),
+            });
+        }
+        *self.latest.lock().unwrap()
+    }
+
+    /// Whether the chip's SFLP output has converged ([`crate::imu::SflpDecoder::ready`]).
+    pub fn ready(&self) -> bool {
+        self.ready.load(Ordering::Relaxed)
+    }
+
+    pub fn update_status(&self, f: impl FnOnce(&mut ReaderStatus)) {
+        f(&mut self.status.lock().unwrap());
+    }
+
+    pub fn status(&self) -> ReaderStatus {
+        self.status.lock().unwrap().clone()
+    }
+
+    /// Polls per second since the reader started, `None` before a second has passed.
+    pub fn poll_hz(&self) -> Option<f64> {
+        let s = self.status();
+        let secs = s.started?.elapsed().as_secs_f64();
+        (secs >= 1.0).then(|| s.polls as f64 / secs)
+    }
+
+    pub fn sample_hz(&self) -> Option<f64> {
+        let s = self.status();
+        let secs = s.started?.elapsed().as_secs_f64();
+        (secs >= 1.0).then(|| s.samples as f64 / secs)
+    }
+}
+
+/// Age of `sample` at `now`, saturating at zero for a sample stamped a hair after `now`.
+pub fn age(sample: &HostSample, now: Instant) -> Duration {
+    now.saturating_duration_since(sample.at)
+}
