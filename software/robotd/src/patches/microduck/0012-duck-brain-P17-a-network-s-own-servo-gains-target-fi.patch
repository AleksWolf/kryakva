+    fn a_runtime_p_that_does_not_take_fails_the_torque_on() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(22).unwrap().refuse = Some(50);
+        emu.servo_mut(22).unwrap().set(50, 1, 32);
+        let mut io = io(emu, quick());
+        io.set_servo_runtime(Some(P5)).unwrap();
+        assert!(io.set_torque(true).is_err());
+        assert_eq!(io.shared().snapshot().torque, Some(false));
+    }
+
+    /// No supply compensation under a network trained without it.
+    #[test]
+    fn a_runtime_without_voltage_adapt_sends_the_target_as_it_is() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        for id in JOINT_IDS {
+            emu.servo_mut(id).unwrap().set(62, 1, 50);
+        }
+        let mut io = io(emu, quick());
+        io.set_servo_runtime(Some(P5)).unwrap();
+        let s = io.read().unwrap();
+        let mut t = s.positions;
+        t[0] += 0.1;
+        io.write(&JointTargets::new(t)).unwrap();
+        assert_eq!(io.shared().snapshot().adapt, 1.0);
+        let goal = io
+            .bus_mut()
+            .port_mut()
+            .servo(JOINT_IDS[0])
+            .unwrap()
+            .get(42, 2);
+        assert_eq!(goal, rad_to_counts(s.positions[0] + 0.1, 1.0));
+    }
 }
