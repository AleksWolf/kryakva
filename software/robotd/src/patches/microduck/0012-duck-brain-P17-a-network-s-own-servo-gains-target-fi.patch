+    /// The driving network's servo settings (P17). With torque on, P and D of the 14 joints are
+    /// written at once, each read back; otherwise they wait for the torque-on. A write that does
+    /// not take is an error, and the settings are kept so the next change or torque-on retries.
+    fn set_servo_runtime(&mut self, runtime: Option<ServoRuntime>) -> Result<()> {
+        if runtime == self.runtime {
+            return Ok(());
+        }
+        self.runtime = runtime;
+        tracing::info!(
+            p = self.pd(JOINT_IDS[0]).0,
+            d = self.pd(JOINT_IDS[0]).1,
+            voltage_adapt = self.cfg.voltage_adapt && runtime.is_none_or(|rt| rt.voltage_adapt),
+            from = if runtime.is_some() {
+                "the network's runtime manifest"
+            } else {
+                "[feetech]"
+            },
+            "servo settings of the 14 joints"
+        );
+        if self.shared.0.lock().unwrap().torque != Some(true) {
+            return Ok(());
+        }
+        let mouth = JOINT_IDS[MOUTH_INDEX];
+        let ids: Vec<u8> = self
+            .present_ids()
+            .into_iter()
+            .filter(|&id| id != mouth)
+            .collect();
+        let kp = self.kp.unwrap_or(self.cfg.gain_ref);
+        let p: Vec<u16> = ids
+            .iter()
+            .map(|&id| u16::from(self.mapped_p(id, kp)))
+            .collect();
+        let d: Vec<u16> = ids.iter().map(|&id| u16::from(self.pd(id).1)).collect();
+        let mut rewrites = 0u64;
+        let mut failed = Vec::new();
+        for (register, values) in [(reg::P, &p), (reg::D, &d)] {
+            failed.extend(
+                feetech::write_verified(
+                    &mut self.bus,
+                    &ids,
+                    register,
+                    values,
+                    self.cfg.torque.retries,
+                    &mut |m, a| {
+                        rewrites += 1;
+                        Self::log_mismatch(m, a);
+                    },
+                )
+                .map_err(|e| IoError::Bus(format!("P/D: {e}")))?
+                .into_iter()
+                .filter_map(std::result::Result::err),
+            );
+        }
+        self.count_writes(&failed, rewrites);
+        if failed.is_empty() {
+            self.record_pd(&ids, &p, Some(&d));
+            Ok(())
+        } else {
+            Err(IoError::Bus(format!("P/D did not take: {}", join(&failed))))
+        }
+    }
