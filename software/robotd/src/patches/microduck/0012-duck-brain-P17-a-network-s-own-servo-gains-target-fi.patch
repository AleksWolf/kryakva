+
+    /// P17: a network's own P/D go to the 14 joints at torque-on, read back; the mouth keeps
+    /// `[feetech]`'s; robot.health carries what each servo holds.
+    #[test]
+    fn a_network_runtime_sets_p_and_d_of_the_fourteen_at_torque_on() {
+        let mut io = io(Emulator::new(&JOINT_IDS), quick());
+        io.set_servo_runtime(Some(P5)).unwrap();
+        io.set_torque(true).unwrap();
+        let mouth = JOINT_IDS[MOUTH_INDEX];
+        let emu = io.bus_mut().port_mut();
+        for id in JOINT_IDS {
+            let s = emu.servo(id).unwrap();
+            let want = if id == mouth { (32, 40) } else { (5, 0) };
+            assert_eq!((s.get(50, 1), s.get(51, 1)), want, "id {id}");
+            assert!(!s.accel_writes.contains(&1), "id {id}: 41 = 1 never");
+        }
+        let snap = io.shared().snapshot();
+        for (j, &id) in JOINT_IDS.iter().enumerate() {
+            let want = if id == mouth {
+                (Some(32), Some(40))
+            } else {
+                (Some(5), Some(0))
+            };
+            assert_eq!((snap.servo_p[j], snap.servo_d[j]), want, "id {id}");
+        }
+    }
+
+    /// With torque already on, a change of network writes P/D at once; back to none, `[feetech]`'s.
+    #[test]
+    fn a_runtime_change_under_torque_writes_p_and_d_at_once() {
+        let mut io = io(Emulator::new(&JOINT_IDS), quick());
+        io.set_torque(true).unwrap();
+        assert_eq!(io.bus_mut().port_mut().servo(12).unwrap().get(50, 1), 32);
+        io.set_servo_runtime(Some(P5)).unwrap();
+        let s = io.bus_mut().port_mut().servo(12).unwrap();
+        assert_eq!((s.get(50, 1), s.get(51, 1)), (5, 0));
+        assert_eq!(
+            io.bus_mut().port_mut().servo(34).unwrap().get(50, 1),
+            32,
+            "the mouth"
+        );
+        // The gain scales the network's P, as it scaled the configured one.
+        io.set_gain(100).unwrap();
+        assert_eq!(
+            io.bus_mut().port_mut().servo(12).unwrap().get(50, 1),
+            3,
+            "5 × 100/200, rounded"
+        );
+        io.set_gain(200).unwrap();
+        io.set_servo_runtime(None).unwrap();
+        let s = io.bus_mut().port_mut().servo(12).unwrap();
+        assert_eq!((s.get(50, 1), s.get(51, 1)), (32, 40));
+    }
+
+    /// A P/D that does not read back fails the torque-on, so the policy does not start on it.
