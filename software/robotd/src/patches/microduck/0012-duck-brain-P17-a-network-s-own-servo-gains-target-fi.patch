+/// A network's runtime manifest (duck-brain P17): `<file stem>.runtime.json` beside the `.onnx`,
+/// for what training assumed that the ONNX metadata does not carry. With one, the network's
+/// target is `clip(home + action_scale · a, clip_lo, clip_hi)` filtered every tick by
+/// `target += target_alpha · (raw − target)`, the servos of the joints it drives run at
+/// `servo_p` / `servo_d`, and supply compensation runs only if `voltage_adapt`.
+#[derive(Debug, Clone, PartialEq, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Runtime {
+    /// Position gain, register units, at the policy's own gain (`[policy] gain`).
+    pub servo_p: u8,
+    pub servo_d: u8,
+    pub action_scale: f64,
+    pub target_alpha: f64,
+    pub voltage_adapt: bool,
+    /// Target limits, radians, in action order (the 14 joints without the mouth).
+    pub clip_lo: [f64; ACTION_LEN],
+    pub clip_hi: [f64; ACTION_LEN],
+    /// The HOME at full precision, in action order: `default_joint_pos` in the metadata is
+    /// rounded to three decimals (P5 walk: −0.087 for −0.0873), which is 4.6e-4 rad off in
+    /// both the observation and the target. Replaces the metadata's, and must round to it.
+    #[serde(default)]
+    pub home: Option<[f64; ACTION_LEN]>,
+    /// Where the numbers came from — for whoever reads the file, not used.
+    #[serde(default)]
+    pub source: Option<String>,
+}
+
+/// The manifest of the network at `path`, if there is one. A manifest that is there and wrong
+/// fails the load, as a wrong network does: running without it is running a different policy.
+fn runtime_manifest(
+    path: &Path,
+    metadata_scale: Option<f64>,
+    metadata_home: Option<&[f64; NUM_JOINTS]>,
+) -> Result<Option<Runtime>, PolicyError> {
+    let manifest = path.with_extension("runtime.json");
