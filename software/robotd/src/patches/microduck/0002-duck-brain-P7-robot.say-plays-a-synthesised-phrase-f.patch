+    /// duck-brain patch P7: `robot.say` plays only a .wav inside `[audio] say_dir`, resolved —
+    /// a path that walks out with `..` is outside — and nothing on a robot with audio off.
+    #[test]
+    fn robot_say_plays_only_a_wav_inside_say_dir() {
+        let intents = Intents::default();
+        let id = || proto::Id::Number(7);
+        let say = |path: &std::path::Path| proto::Call::RobotSay(proto::SayParams { path: path.to_string_lossy().into() });
+        let root = std::env::temp_dir().join(format!("robot-say-{}", std::process::id()));
+        let dir = root.join("duck-say");
+        std::fs::create_dir_all(&dir).unwrap();
+        let wav = dir.join("say-0.wav");
+        std::fs::write(&wav, b"RIFF").unwrap();
+        std::fs::write(dir.join("notes.txt"), b"x").unwrap();
+        std::fs::write(root.join("secret.wav"), b"RIFF").unwrap();
+        let mut params = Params::default();
+        params.audio.say_dir = dir.clone();
+        let state = RobotState::new(&params, std::path::Path::new("/test/robotd.toml"), false, false);
+        let ask = |path: &std::path::Path| -> proto::IntentResult { dispatch(&state, &intents, id(), &say(path)).result_as().unwrap() };
+
+        for bad in [root.join("secret.wav"), dir.join("../secret.wav"), dir.join("notes.txt"), dir.join("none.wav")] {
+            let r = ask(&bad);
+            assert!(!r.accepted && r.reason.is_some(), "{}", bad.display());
+        }
+        assert!(intents.take_say().is_none(), "a refusal must not queue");
+        assert!(ask(&wav).accepted);
+        assert_eq!(intents.take_say(), Some(wav.canonicalize().unwrap()));
+
+        params.audio.enabled = false;
+        let mute = RobotState::new(&params, std::path::Path::new("/test/robotd.toml"), false, false);
+        let r: proto::IntentResult = dispatch(&mute, &intents, id(), &say(&wav)).result_as().unwrap();
+        assert!(!r.accepted, "audio off: no voice");
+        std::fs::remove_dir_all(&root).ok();
+    }
+
