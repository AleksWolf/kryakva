+    /// Play a synthesised phrase (`robot.say`, duck-brain patch P7): the same single child as
+    /// a bank sound — it cuts what is playing and the next sound cuts it — and, like one, it
+    /// waits for no ride to end.
+    pub fn play_file(&mut self, wav: &Path) {
+        if self.ride != Ride::Off {
+            tracing::debug!(wav = %wav.display(), "phrase skipped: the wheee ride has the PCM");
+            return;
+        }
+        self.stop_child();
+        self.spawn_wav(wav, false, "say");
+    }
+
+    fn spawn_wav(&mut self, wav: &Path, blocking: bool, tag: &str) {
         let child = Command::new("aplay")
             .args(["-q", "-D", &self.device])
-            .arg(&wav)
+            .arg(wav)
             .stdin(Stdio::null())
             .stdout(Stdio::null())
             .stderr(Stdio::null())
