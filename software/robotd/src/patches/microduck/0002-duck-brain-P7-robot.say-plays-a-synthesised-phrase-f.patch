+        // a client names a file, never a place, so `..` and links out of the folder are refused.
+        proto::Call::RobotSay(p) => {
+            let result = match say_file(state.say_dir.as_deref(), &p.path) {
+                Ok(wav) => {
+                    intents.request_say(wav);
+                    proto::IntentResult::accepted()
+                }
+                Err(why) => proto::IntentResult::refused(why),
+            };
+            proto::Response::ok(Some(id), &result)
+        }
