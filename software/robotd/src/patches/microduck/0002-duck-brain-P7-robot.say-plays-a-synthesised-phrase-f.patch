+/// The wav `robot.say` may play: inside `dir` once both are resolved, a `.wav`, a file.
+fn say_file(dir: Option<&std::path::Path>, path: &str) -> Result<PathBuf, String> {
+    let dir = dir.ok_or("this robot has no voice: audio is disabled")?;
+    let dir = dir
+        .canonicalize()
+        .map_err(|e| format!("say_dir {}: {e}", dir.display()))?;
+    let wav = std::path::Path::new(path)
+        .canonicalize()
+        .map_err(|e| format!("{path}: {e}"))?;
+    if !wav.starts_with(&dir) {
+        return Err(format!("{path} is outside {}", dir.display()));
+    }
+    if wav.extension().is_none_or(|x| x != "wav") || !wav.is_file() {
+        return Err(format!("{path} is not a .wav file"));
+    }
+    Ok(wav)
+}
