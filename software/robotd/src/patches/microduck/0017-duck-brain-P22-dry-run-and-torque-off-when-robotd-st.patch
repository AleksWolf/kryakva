+    /// `--dry-run` (P22): reads as usual, not one write on the bus — torque on, goals, gain, a
+    /// network's P/D, torque off, and the drop — while the loop's view and the journal go on.
+    #[test]
+    fn a_dry_run_writes_nothing_and_journals_the_goals() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(13).unwrap().set(56, 2, 2600);
+        let cfg = FeetechConfig {
+            dry_run: true,
+            ..quick()
+        };
+        let mut io = io(emu, cfg);
+        io.bus_mut().port_mut().log.clear();
+        let before = io.bus_mut().port_mut().servo(13).unwrap().regs;
+        io.set_torque(true).unwrap();
+        let s = io.read().unwrap();
+        let mut goal = s.positions;
+        goal[12] += 0.5;
+        io.write(&JointTargets::new(goal)).unwrap();
+        io.set_gain(100).unwrap();
+        io.set_servo_runtime(Some(ServoRuntime {
+            p: 5,
+            d: 0,
+            voltage_adapt: false,
+        }))
+        .unwrap();
+        let j = io.journal().unwrap();
+        assert_ne!(j["goal_raw"][12], 2600, "the goal is journalled");
+        let snap = io.shared().snapshot();
+        assert!(snap.dry_run);
+        assert_eq!(snap.torque, Some(true), "the loop is told torque is on");
+        io.set_torque(false).unwrap();
+        io.set_torque(true).unwrap();
+        let shared = io.shared();
+        let emu = io.bus_mut().port_mut();
+        let writes: Vec<_> = emu
+            .log
+            .iter()
+            .filter(|(_, instr, _)| *instr == feetech::WRITE || *instr == feetech::SYNC_WRITE)
+            .collect();
+        assert!(writes.is_empty(), "{writes:?}");
+        assert!(emu.servo(13).unwrap().regs == before, "registers untouched");
+        drop(io);
+        assert_eq!(
+            shared.snapshot().torque,
+            Some(true),
+            "the drop wrote nothing either"
+        );
+    }
+
+    /// A bus gone silent with torque on (P22): the fifth read nobody answers cuts torque everywhere,
+    /// three unverified writes of 40 = 0; health says so until the next torque-on.
+    #[test]
+    fn a_silent_bus_cuts_torque_on_the_fifth_tick() {
+        let emu = Emulator::new(&JOINT_IDS);
+        let mut io = io(emu, quick());
+        io.set_torque(true).unwrap();
+        for id in JOINT_IDS {
+            io.bus_mut().port_mut().servo_mut(id).unwrap().silent = true;
+        }
+        io.bus_mut().port_mut().log.clear();
+        let torque_writes = |io: &mut FeetechIo<Emulator>| {
+            io.bus_mut()
+                .port_mut()
+                .log
+                .iter()
+                .filter(|(_, instr, addr)| *instr == feetech::SYNC_WRITE && *addr == 40)
+                .count()
+        };
+        for _ in 0..SILENT_CUTOFF_TICKS - 1 {
+            assert!(io.read().is_err());
+        }
+        assert_eq!(torque_writes(&mut io), 0, "not before the fifth");
+        assert!(!io.shared().snapshot().silent_cutoff);
+        assert!(io.read().is_err());
+        assert_eq!(torque_writes(&mut io), 3);
+        let snap = io.shared().snapshot();
+        assert!(snap.silent_cutoff && snap.torque == Some(false));
+        assert!(io.read().is_err());
+        assert_eq!(torque_writes(&mut io), 3, "once");
+        for id in JOINT_IDS {
+            io.bus_mut().port_mut().servo_mut(id).unwrap().silent = false;
+        }
+        io.read().unwrap();
+        let emu = io.bus_mut().port_mut();
+        assert!(
+            JOINT_IDS
+                .iter()
+                .all(|&id| emu.servo(id).unwrap().get(40, 1) == 0),
+            "servos that heard none of the cut get it, verified, once they answer"
+        );
+        assert!(
+            io.shared().snapshot().silent_cutoff,
+            "until torque comes on again"
+        );
+        io.set_torque(true).unwrap();
+        assert!(!io.shared().snapshot().silent_cutoff);
+    }
+
+    /// A port the test keeps a handle on, to see what the driver wrote as it was dropped.
+    struct Kept(Arc<Mutex<Emulator>>);
+
+    impl feetech::Port for Kept {
+        fn send(&mut self, bytes: &[u8]) -> std::io::Result<()> {
+            self.0.lock().unwrap().send(bytes)
+        }
+        fn recv(&mut self, buf: &mut [u8], timeout: Duration) -> std::io::Result<usize> {
+            self.0.lock().unwrap().recv(buf, timeout)
+        }
+        fn discard_input(&mut self) -> std::io::Result<()> {
+            self.0.lock().unwrap().discard_input()
+        }
+    }
+
+    /// robotd stopping (P22): the driver dropped with torque on takes it off every servo; one that
+    /// never switched it on writes nothing.
+    #[test]
+    fn dropping_the_driver_takes_torque_off() {
+        let emu = Arc::new(Mutex::new(Emulator::new(&JOINT_IDS)));
+        let mut io = FeetechIo::with_port(
+            Kept(Arc::clone(&emu)),
+            quick(),
+            Arc::default(),
+            Arc::new(ImuFeed::new()),
+        );
+        assert!(io.census().unwrap().is_empty());
+        io.set_torque(true).unwrap();
+        assert!(
+            JOINT_IDS
+                .iter()
+                .all(|&id| emu.lock().unwrap().servo(id).unwrap().get(40, 1) == 1)
+        );
+        drop(io);
+        assert!(
+            JOINT_IDS
+                .iter()
+                .all(|&id| emu.lock().unwrap().servo(id).unwrap().get(40, 1) == 0)
+        );
+
+        let emu = Arc::new(Mutex::new(Emulator::new(&JOINT_IDS)));
+        let mut io = FeetechIo::with_port(
+            Kept(Arc::clone(&emu)),
+            quick(),
+            Arc::default(),
+            Arc::new(ImuFeed::new()),
+        );
+        assert!(io.census().unwrap().is_empty());
+        emu.lock().unwrap().log.clear();
+        drop(io);
+        assert!(
+            emu.lock().unwrap().log.is_empty(),
+            "torque was never on: nothing written"
+        );
+    }
+
