+/// robotd stopping — Ctrl+C, SIGTERM, the end of the loop, a panic unwinding through it — takes
+/// torque off every servo (duck-brain P22, Alex 07.11.2026): a duck is not left stiff with nothing
+/// driving it. A standing duck then falls; `robot.relax` first is still the gentle way. Only when
+/// this run switched torque on (an IO dropped while waiting for its servos writes nothing), and
+/// never in a dry run, which writes nothing.
+impl<P: Port> Drop for FeetechIo<P> {
+    fn drop(&mut self) {
+        if self.cfg.dry_run || self.shared.0.lock().unwrap().torque != Some(true) {
+            return;
+        }
+        tracing::warn!("stopping: torque off on every servo");
+        for attempt in 1..=3u32 {
+            match self.torque_off_all() {
+                Ok(()) => return,
+                Err(e) => {
+                    tracing::warn!(error = %e, attempt, "torque off at stop did not take everywhere")
+                }
+            }
+        }
+    }
+}
