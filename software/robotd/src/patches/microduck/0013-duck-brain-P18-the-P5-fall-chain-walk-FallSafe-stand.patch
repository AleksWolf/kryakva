+    /// Every network of a set asks the servos for the same P/D (duck-brain P18): a network trained
+    /// at 32/40 driven at a P5 network's 5/0 — or the other way round — is a different policy, and
+    /// switching the registers under a moving robot between two networks is a jolt nobody trained.
+    /// So a set is all one or all the other; a network without a manifest counts as `[feetech]`'s.
+    fn check_servo_settings(&self) -> Result<(), PolicyError> {
+        let servo = |n: &Network| n.runtime.as_ref().map(|r| (r.servo_p, r.servo_d));
+        let want = servo(&self.walk);
+        let others = [&self.stand, &self.sitstand, &self.ground_pick]
+            .into_iter()
+            .flatten()
+            .chain(self.skills.iter());
+        for network in others {
+            let got = servo(network);
+            if got != want {
+                let say = |pd: Option<(u8, u8)>| {
+                    pd.map_or("[feetech]'s (no runtime manifest)".to_owned(), |(p, d)| format!("P {p} / D {d}"))
+                };
+                return Err(shape_error(
+                    &network.path,
+                    "servo P/D",
+                    &format!("{}, as the walking network's", say(want)),
+                    say(got),
+                ));
+            }
+        }
+        Ok(())
+    }
