+/// Set by SIGINT or SIGTERM while `robotd body-imu` runs (duck-brain P24).
+static STOP: AtomicBool = AtomicBool::new(false);
+
+extern "C" fn on_stop(_: libc::c_int) {
+    STOP.store(true, Ordering::Release);
+}
+
+/// Ctrl-C and SIGTERM stop the bench (P24). Installed rather than left to the default: a
+/// command started in the background, or over a non-interactive ssh, inherits SIGINT ignored,
+/// and Ctrl-C or `kill -INT` then did nothing. No SA_RESTART, so a wait at the Enter prompt
+/// ends too.
+fn stop_on_signals() {
+    for sig in [libc::SIGINT, libc::SIGTERM] {
+        // SAFETY: a zeroed sigaction with only the handler set; the handler only stores an atomic.
+        unsafe {
+            let mut action: libc::sigaction = std::mem::zeroed();
+            action.sa_sigaction = on_stop as *const () as libc::sighandler_t;
+            libc::sigemptyset(&mut action.sa_mask);
+            libc::sigaction(sig, &action, std::ptr::null_mut());
+        }
+    }
+}
