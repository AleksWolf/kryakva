+    /// A quarter turn clockwise puts the top-left corner top-right, as a picture turned by hand;
+    /// 270 puts it bottom-left; four quarter turns are none.
+    #[test]
+    fn turn_cw_turns_like_a_picture() {
+        // 0 1 2
+        // 3 4 5
+        // 6 7 8
+        let g: Vec<u8> = (0..9).collect();
+        assert_eq!(turn_cw(&g, 3, 90), [6, 3, 0, 7, 4, 1, 8, 5, 2]);
+        assert_eq!(turn_cw(&g, 3, 180), [8, 7, 6, 5, 4, 3, 2, 1, 0]);
+        assert_eq!(turn_cw(&g, 3, 270), [2, 5, 8, 1, 4, 7, 0, 3, 6]);
+        assert_eq!(turn_cw(&g, 3, 0), g);
+        let mut h = g.clone();
+        for _ in 0..4 {
+            h = turn_cw(&h, 3, 90);
+        }
+        assert_eq!(h, g);
+        assert_eq!(turn_cw(&turn_cw(&g, 3, 270), 3, 90), g);
+        assert_eq!(turn_cw(&g, 3, 45), g, "not a quarter turn: untouched");
+    }
