+/// Turn a row-major `side`×`side` grid `degrees` clockwise (0, 90, 180, 270; no mirror) — the
+/// sensor's raw frame into the duck's view (duck-brain P24, `[tof] rotate`). A grid that is not
+/// square, or an angle that is not a quarter turn, comes back as it was.
+pub fn turn_cw<T: Copy>(grid: &[T], side: usize, degrees: u32) -> Vec<T> {
+    if grid.len() != side * side || !matches!(degrees, 90 | 180 | 270) {
+        return grid.to_vec();
+    }
+    let n = side;
+    (0..n * n)
+        .map(|i| {
+            let (r, c) = (i / n, i % n);
+            let (sr, sc) = match degrees {
+                90 => (n - 1 - c, r),
+                180 => (n - 1 - r, n - 1 - c),
+                _ => (c, n - 1 - r),
+            };
+            grid[sr * n + sc]
+        })
+        .collect()
+}
+
