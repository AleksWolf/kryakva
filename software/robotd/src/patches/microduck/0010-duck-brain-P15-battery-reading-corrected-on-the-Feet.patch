+    /// rest, register 62 read 0.0–0.1 V below a multimeter on the servo connector; the 0.7 V seen
+    /// earlier was a scope peak against the register while walking, not a constant. The voltage
+    /// adaptation and the cutoff above stay on the register as read.
+    pub battery_offset_v: f64,
     /// Direction per joint, +1 or −1.
     pub sign: JointSigns,
 }
@@ -2395,6 +2401,7 @@ impl Default for FeetechParams {
             cutoff_ticks: 5,
             velocity: FeetechVelocity::PositionDelta,
             speed_rad_per_count: std::f64::consts::TAU / 4096.0,
+            battery_offset_v: 0.1,
             sign: JointSigns::default(),
         }
     }
@@ -2840,6 +2847,9 @@ impl Params {
             if f.speed == 0 {
                 return Err(setting("speed", "0 means stop, not unlimited".into()));
             }
+            if !(0.0..=2.0).contains(&f.battery_offset_v) {
+                return Err(setting("battery_offset_v", format!("{} must be 0–2 V", f.battery_offset_v)));
+            }
         }
         if self.body_imu.enabled_for(self.bus.driver) {
             let setting = |key: &str, reason: String| ParamsError::Setting {
