-pub const FLUSH_EVERY: std::time::Duration = std::time::Duration::from_secs(180);
+pub const FLUSH_EVERY: std::time::Duration = std::time::Duration::from_secs(2);
+
+/// What the control thread hands the writer.
+enum Msg {
+    Line(String),
+    /// Everything so far to the file now (P28).
+    Flush,
+}
+
+/// `path` if nothing is there; otherwise `<stem>-<YYYYMMDD-HHMMSS UTC>.<ext>` beside it, with
+/// `-2`, `-3`… if that is taken too (P28). A board without an RTC may say 1970 until NTP has run:
+/// the name is still new.
+pub fn free_path(path: &Path) -> std::path::PathBuf {
+    if !path.exists() {
+        return path.to_path_buf();
+    }
+    let stem = path
+        .file_stem()
+        .map(|s| s.to_string_lossy().into_owned())
+        .unwrap_or_default();
+    let ext = path
+        .extension()
+        .map(|e| format!(".{}", e.to_string_lossy()))
+        .unwrap_or_default();
+    let stamp = utc_stamp(std::time::SystemTime::now());
+    let mut n = 1;
+    loop {
+        let name = if n == 1 {
+            format!("{stem}-{stamp}{ext}")
+        } else {
+            format!("{stem}-{stamp}-{n}{ext}")
+        };
+        let candidate = path.with_file_name(name);
+        if !candidate.exists() {
+            return candidate;
+        }
+        n += 1;
+    }
+}
+
+/// `YYYYMMDD-HHMMSS`, UTC (days to a civil date: Howard Hinnant's `civil_from_days`).
+fn utc_stamp(t: std::time::SystemTime) -> String {
+    let secs = t
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs()) as i64;
+    let (days, rem) = (secs.div_euclid(86_400), secs.rem_euclid(86_400));
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = yoe + era * 400 + i64::from(m <= 2);
+    format!(
+        "{y:04}{m:02}{d:02}-{:02}{:02}{:02}",
+        rem / 3600,
+        rem % 3600 / 60,
+        rem % 60
+    )
+}
 
 pub struct Journal {
-    tx: Option<SyncSender<String>>,
