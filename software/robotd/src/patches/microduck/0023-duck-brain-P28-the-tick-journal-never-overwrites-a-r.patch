+
+    /// P28: a journal never overwrites an earlier run. The path taken goes to a new file beside it,
+    /// named by the start time; the old one is left byte for byte.
+    #[test]
+    fn an_earlier_journal_is_never_overwritten() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("walk.jsonl");
+        std::fs::write(&path, "18057 ticks of a walk\n").unwrap();
+        let header = serde_json::json!({ "journal": 1 });
+        let first = Journal::open(&path, &header, FLUSH_EVERY).unwrap();
+        let second = Journal::open(&path, &header, FLUSH_EVERY).unwrap();
+        let (a, b) = (first.path.clone(), second.path.clone());
+        drop((first, second));
+        assert_eq!(
+            std::fs::read_to_string(&path).unwrap(),
+            "18057 ticks of a walk\n"
+        );
+        assert_ne!(a, path);
+        assert_ne!(a, b, "two in the same second do not share a name");
+        let name = a.file_name().unwrap().to_string_lossy().into_owned();
+        assert!(
+            name.starts_with("walk-")
+                && name.ends_with(".jsonl")
+                && name.len() == "walk-20261108-160155.jsonl".len(),
+            "{name}"
+        );
+        for p in [&a, &b] {
+            assert!(
+                std::fs::read_to_string(p)
+                    .unwrap()
+                    .starts_with("{\"journal\":1}")
+            );
+        }
+        // A free path is used as it is.
+        let fresh = dir.path().join("fresh.jsonl");
+        assert_eq!(free_path(&fresh), fresh);
+    }
+
+    #[test]
+    fn the_stamp_is_utc() {
+        let t = std::time::UNIX_EPOCH + std::time::Duration::from_secs(1_794_153_715); // 2026-11-08T16:01:55Z
+        assert_eq!(utc_stamp(t), "20261108-160155");
+        assert_eq!(utc_stamp(std::time::UNIX_EPOCH), "19700101-000000");
+        let leap = std::time::UNIX_EPOCH + std::time::Duration::from_secs(951_782_400); // 2000-02-29
+        assert_eq!(utc_stamp(leap), "20000229-000000");
+    }
+
+    /// P28: `flush_now` writes what is queued at once, however long the batch period.
+    #[test]
+    fn flush_now_writes_at_once() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("j.jsonl");
+        let lines = |p: &Path| std::fs::read_to_string(p).unwrap().lines().count();
+        let mut j = Journal::open(
+            &path,
+            &serde_json::json!({ "journal": 1 }),
+            std::time::Duration::from_secs(600),
+        )
+        .unwrap();
+        for i in 0..5 {
+            j.write(&serde_json::json!({ "tick": i }));
+        }
+        j.flush_now();
+        std::thread::sleep(std::time::Duration::from_millis(200));
+        assert_eq!(
+            lines(&path),
+            6,
+            "header and the five, long before the period"
+        );
+    }
 }
