 }
 
+/// Silence before every wav (P20): the amplifier's enable follows the stream with ~30 ms delay.
+const LEAD_SILENCE: Duration = Duration::from_millis(50);
+/// Zeros after every wav, and after the fade of one cut short.
+const TAIL_SILENCE: Duration = Duration::from_millis(30);
+/// How long a cut wav fades.
+const CUT_FADE: Duration = Duration::from_millis(20);
+/// How far ahead of real time the feeder writes: what a cut still plays before its fade.
+const FEED_AHEAD: Duration = Duration::from_millis(100);
+/// A faded wav still running after this is killed.
+const DRAIN_MAX: Duration = Duration::from_secs(1);
+
+/// A 16-bit PCM wav, as [`feed_wav`] plays it.
+struct Wav16 {
+    rate: u32,
+    channels: u16,
+    /// Interleaved samples.
+    samples: Vec<i16>,
+}
+
+/// Read a 16-bit PCM wav of any rate and channel count; `None` for anything else.
+fn read_wav16(path: &Path) -> Option<Wav16> {
+    let b = std::fs::read(path).ok()?;
+    if b.len() < 12 || &b[..4] != b"RIFF" || &b[8..12] != b"WAVE" {
+        return None;
+    }
+    let mut fmt: Option<(u16, u16, u32, u16)> = None;
+    let mut pos = 12usize;
+    while pos + 8 <= b.len() {
+        let sz = u32::from_le_bytes(b[pos + 4..pos + 8].try_into().ok()?) as usize;
+        let body = pos + 8;
+        match &b[pos..pos + 4] {
+            b"fmt " if body + 16 <= b.len() => {
+                let u16_at = |i: usize| u16::from_le_bytes([b[body + i], b[body + i + 1]]);
+                let rate = u32::from_le_bytes(b[body + 4..body + 8].try_into().ok()?);
+                fmt = Some((u16_at(0), u16_at(2), rate, u16_at(14)));
+            }
+            b"data" => {
+                let (format, channels, rate, bits) = fmt?;
+                if format != 1 || bits != 16 || channels == 0 || rate == 0 {
+                    return None;
+                }
+                let data = &b[body..(body + sz).min(b.len())];
+                let samples = data
+                    .chunks_exact(2)
+                    .map(|c| i16::from_le_bytes([c[0], c[1]]))
+                    .collect();
+                return Some(Wav16 {
+                    rate,
+                    channels,
+                    samples,
+                });
+            }
+            _ => {}
+        }
+        pos = body + sz + (sz & 1);
+    }
+    None
+}
+
+/// `d` of `wav`, in interleaved samples.
+fn samples_in(wav: &Wav16, d: Duration) -> usize {
+    (d.as_secs_f64() * f64::from(wav.rate)).round() as usize * usize::from(wav.channels)
+}
+
+/// The end of a wav cut at sample `at`: its next [`CUT_FADE`] faded linearly to zero.
+fn faded_from(wav: &Wav16, at: usize) -> Vec<i16> {
+    let fade = samples_in(wav, CUT_FADE).max(1);
+    wav.samples[at.min(wav.samples.len())..]
+        .iter()
+        .take(fade)
+        .enumerate()
+        .map(|(k, &s)| (f64::from(s) * (1.0 - (k + 1) as f64 / fade as f64)).round() as i16)
+        .collect()
+}
+
+/// Write `wav` to `aplay`'s stdin (P20): [`LEAD_SILENCE`] of zeros, the samples in 20 ms chunks
+/// at most [`FEED_AHEAD`] ahead of real time, [`TAIL_SILENCE`] of zeros, then EOF — `aplay`
+/// drains and exits. With `fade` set the rest is replaced by a [`CUT_FADE`] fade, so a cut is
+/// heard within ~100 ms and ends in zeros rather than mid-wave.
+fn feed_wav(mut stdin: std::process::ChildStdin, wav: &Wav16, fade: &AtomicBool) {
+    use std::io::Write;
+    let written = std::cell::Cell::new(0usize);
+    let mut put = |samples: &[i16]| -> bool {
+        written.set(written.get() + samples.len());
+        let bytes: Vec<u8> = samples.iter().flat_map(|s| s.to_le_bytes()).collect();
+        stdin.write_all(&bytes).is_ok()
+    };
+    let per_second = f64::from(wav.rate) * f64::from(wav.channels);
+    let chunk = samples_in(wav, Duration::from_millis(20)).max(1);
+    let started = Instant::now();
+    if !put(&vec![0; samples_in(wav, LEAD_SILENCE)]) {
+        return;
+    }
+    let mut at = 0usize;
+    while at < wav.samples.len() {
+        if fade.load(Ordering::Relaxed) {
+            if !put(&faded_from(wav, at)) {
+                return;
+            }
+            break;
+        }
+        if written.get() as f64 / per_second - started.elapsed().as_secs_f64()
+            > FEED_AHEAD.as_secs_f64()
+        {
+            std::thread::sleep(Duration::from_millis(5));
+            continue;
+        }
+        let end = (at + chunk).min(wav.samples.len());
+        if !put(&wav.samples[at..end]) {
+            return;
+        }
+        at = end;
+    }
+    let _ = put(&vec![0; samples_in(wav, TAIL_SILENCE)]);
