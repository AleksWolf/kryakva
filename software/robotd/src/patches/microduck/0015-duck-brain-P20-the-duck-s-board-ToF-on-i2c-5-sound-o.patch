+/// The band a new profile for a network is pinned to (duck-brain P20). On the duck the Wi-Fi and the
+/// Bluetooth pad share one aic8800 chip and antenna, and on 2.4 GHz the Wi-Fi dropped out whenever
+/// the pad was connected (Alex, 05.11.2026) — so the robot stays on 5 GHz. The band of the profile
+/// being replaced is kept; a network with no profile yet is pinned to 5 GHz (`"a"`) when the scan
+/// saw it there; one seen only on 2.4 GHz is left unpinned, which is the only way to join it.
+fn band_for(saved: Option<&str>, seen_mhz: &[u32]) -> Option<String> {
+    match saved {
+        Some(band) if !band.is_empty() => Some(band.to_owned()),
+        _ if seen_mhz.iter().any(|&f| f >= 4900) => Some("a".to_owned()),
+        _ => None,
+    }
+}
