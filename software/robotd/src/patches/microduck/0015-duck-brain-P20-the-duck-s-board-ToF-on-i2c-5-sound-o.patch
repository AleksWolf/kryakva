+        let run = |cut: bool| -> Vec<i16> {
+            let mut cat = Command::new("cat")
+                .stdin(Stdio::piped())
+                .stdout(Stdio::piped())
+                .spawn()
+                .unwrap();
+            let stdin = cat.stdin.take().unwrap();
+            let fade = AtomicBool::new(cut);
+            feed_wav(stdin, &wav, &fade);
+            let out = cat.wait_with_output().unwrap().stdout;
+            out.chunks_exact(2)
+                .map(|c| i16::from_le_bytes([c[0], c[1]]))
+                .collect()
+        };
+        let whole = run(false);
+        assert_eq!(whole.len(), 50 + 1000 + 30);
+        assert!(whole[..50].iter().all(|&s| s == 0) && whole[1050..].iter().all(|&s| s == 0));
+        assert!(whole[50..1050].iter().all(|&s| s == 10_000));
+        let cut = run(true);
+        assert_eq!(
+            cut.len(),
+            50 + 20 + 30,
+            "cut before the first chunk: lead, fade, tail"
+        );
+        let fade = &cut[50..70];
+        assert!(
+            fade.windows(2).all(|w| w[1] <= w[0]) && fade[19] == 0,
+            "{fade:?}"
+        );
+        assert!(cut[70..].iter().all(|&s| s == 0));
+    }
