+/// One torque-on, in the journal: the acceleration check per servo (P16), then one line with the
+/// time and the 41 = 0 rewrites by id. `group` is "joints" (the 14 the policy drives) or "mouth".
+fn log_torque_on(group: &str, servos: usize, took: Duration, report: &feetech::TorqueOnReport) {
+    // A servo still ramping starts late, which the policy feels.
+    for &(id, n) in &report.accel_rewrites {
+        tracing::warn!(
+            id,
+            joint = joint_name(id),
+            rewrites = n,
+            "internal goal (67) lagged the nudge; 41 = 0 written again"
+        );
+    }
+    for &id in &report.accel_stuck {
+        tracing::error!(
+            id,
+            joint = joint_name(id),
+            "internal goal (67) still lags after every 41 = 0: this servo's profile keeps its acceleration and it will start late"
+        );
+    }
+    let by_id: Vec<String> = report
+        .accel_rewrites
+        .iter()
+        .map(|(id, n)| format!("{id}:{n}"))
+        .collect();
+    tracing::info!(
+        group,
+        servos,
+        ms = format!("{:.1}", took.as_secs_f64() * 1000.0),
+        rewrites_41_by_id = if by_id.is_empty() { "none".to_owned() } else { by_id.join(" ") },
+        stuck = ?report.accel_stuck,
+        ok = report.failed.is_empty(),
+        "torque-on done"
+    );
+}
+
+fn joint_name(id: u8) -> &'static str {
+    JOINT_IDS
+        .iter()
+        .position(|&j| j == id)
+        .map_or("?", |i| JOINT_NAMES[i])
+}
