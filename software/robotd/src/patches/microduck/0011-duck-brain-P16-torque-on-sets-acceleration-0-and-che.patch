+/// register write itself never read back (41 or the goal), as for every other step.
+#[allow(clippy::type_complexity)]
+fn accel_zero<P: Port>(
+    bus: &mut Bus<P>,
+    ids: &[u8],
+    present: &[u16],
+    retries: u32,
+    on_mismatch: &mut dyn FnMut(&Mismatch, u32),
