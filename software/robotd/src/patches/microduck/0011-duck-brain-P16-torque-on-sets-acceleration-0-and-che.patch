+    /// A servo whose profile keeps ramping is reported in the shared numbers; torque is on.
+    #[test]
+    fn a_stuck_acceleration_reaches_the_shared_numbers() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(23).unwrap().internal_accel = 1;
+        emu.servo_mut(23).unwrap().stuck_accel = 99;
+        emu.servo_mut(31).unwrap().internal_accel = 1;
+        emu.servo_mut(31).unwrap().stuck_accel = 1;
+        let mut io = io(emu, quick());
+        io.set_torque(true).unwrap();
+        let snap = io.shared().snapshot();
+        assert_eq!(snap.accel_stuck, vec![23]);
+        assert_eq!(snap.accel_rewrites, 5 + 1, "23: five, 31: one");
+        let j = |id: u8| JOINT_IDS.iter().position(|&x| x == id).unwrap();
+        assert_eq!(
+            (
+                snap.torque_on_rewrites[j(23)],
+                snap.torque_on_rewrites[j(31)],
+                snap.torque_on_rewrites[j(10)]
+            ),
+            (5, 1, 0)
+        );
+        assert!(snap.torque_on_ms.is_some_and(|ms| ms > 0.0));
+        assert!(snap.mouth_torque_on_ms.is_some_and(|ms| ms > 0.0));
+        assert_eq!(snap.torque, Some(true));
+    }
+
+    /// The mouth is not one of the policy's 14 joints: it comes on after them, on its own, with
+    /// its own time and its own rewrites.
+    #[test]
+    fn the_mouth_comes_on_after_the_fourteen_on_its_own() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(34).unwrap().internal_accel = 1;
+        emu.servo_mut(34).unwrap().stuck_accel = 2;
+        let mut io = io(emu, quick());
+        io.set_torque(true).unwrap();
+        let snap = io.shared().snapshot();
+        let j = |id: u8| JOINT_IDS.iter().position(|&x| x == id).unwrap();
+        assert_eq!(snap.torque_on_rewrites[j(34)], 2);
+        assert_eq!(snap.accel_rewrites, 2);
+        assert!(snap.accel_stuck.is_empty());
+        assert!(snap.torque_on_ms.is_some() && snap.mouth_torque_on_ms.is_some());
+        // Torque (40) = 1: one sync_write for the 14, then one for the mouth alone.
+        let log = &io.bus_mut().port_mut().log;
+        let torque_writes: Vec<usize> = log
+            .iter()
+            .enumerate()
+            .filter(|(_, e)| **e == (0xFE, 0x83, 40))
+            .map(|(k, _)| k)
+            .collect();
+        assert_eq!(torque_writes.len(), 2);
+        let emu = io.bus_mut().port_mut();
+        assert!(
+            JOINT_IDS
+                .iter()
+                .all(|&id| emu.servo(id).unwrap().get(40, 1) == 1)
+        );
+        assert!(
+            JOINT_IDS
+                .iter()
+                .all(|&id| !emu.servo(id).unwrap().accel_writes.contains(&1))
+        );
+    }
+
+    /// A mouth that will not take torque fails the whole torque-on: the 14 come off again.
+    #[test]
+    fn a_mouth_that_refuses_torque_takes_the_joints_off_again() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(34).unwrap().refuse = Some(40);
+        let mut io = io(emu, quick());
+        assert!(io.set_torque(true).is_err());
+        let snap = io.shared().snapshot();
+        assert_eq!(snap.torque, Some(false));
+        assert!(snap.torque_on_ms.is_some() && snap.mouth_torque_on_ms.is_some());
+        let emu = io.bus_mut().port_mut();
+        assert!(
+            JOINT_IDS
+                .iter()
+                .all(|&id| emu.servo(id).unwrap().get(40, 1) == 0)
+        );
+    }
+
+    /// Joints that fail leave the mouth untouched, and untimed.
+    #[test]
+    fn failing_joints_never_try_the_mouth() {
+        let mut emu = Emulator::new(&JOINT_IDS);
+        emu.servo_mut(12).unwrap().refuse = Some(40);
+        let mut io = io(emu, quick());
+        assert!(io.set_torque(true).is_err());
+        let snap = io.shared().snapshot();
+        assert_eq!(snap.mouth_torque_on_ms, None);
+        // The mouth's torque limit (48) is never written, nor its acceleration (41).
+        let mouth = io.bus_mut().port_mut().servo(34).unwrap();
+        assert_eq!(mouth.get(48, 2), 0);
+        assert!(mouth.accel_writes.is_empty());
+    }
 }
