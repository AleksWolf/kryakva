+    let mut tries: Vec<u32> = vec![0; ids.len()];
+    for attempt in 0..=retries {
+        let sub_ids: Vec<u8> = pending.iter().map(|&k| ids[k]).collect();
+        let pick = |v: &[u16]| pending.iter().map(|&k| v[k]).collect::<Vec<_>>();
+        let failed: Vec<Mismatch> = write_verified(
+            bus,
+            &sub_ids,
+            reg::ACCELERATION,
+            &vec![0; sub_ids.len()],
+            retries,
+            on_mismatch,
+        )?
+        .into_iter()
+        .filter_map(Result::err)
+        .collect();
+        if !failed.is_empty() {
+            return Ok(Err(failed));
+        }
+        std::thread::sleep(ACCEL_SETTLE);
+        let target = pick(&nudged);
+        let bytes: Vec<(u8, Vec<u8>)> = sub_ids
+            .iter()
+            .zip(&target)
+            .map(|(&id, &g)| (id, le(g, 2)))
+            .collect();
+        let refs: Vec<(u8, &[u8])> = bytes.iter().map(|(id, b)| (*id, b.as_slice())).collect();
+        bus.sync_write(reg::GOAL.0, reg::GOAL.1, &refs)?;
+        let deadline = Instant::now() + ACCEL_WINDOW;
+        let mut followed = vec![false; sub_ids.len()];
+        loop {
+            let ask: Vec<usize> = (0..sub_ids.len()).filter(|&i| !followed[i]).collect();
+            let ask_ids: Vec<u8> = ask.iter().map(|&i| sub_ids[i]).collect();
+            let back = bus.sync_read(&ask_ids, reg::INTERNAL_GOAL.0, reg::INTERNAL_GOAL.1)?;
+            for (slot, &i) in ask.iter().enumerate() {
