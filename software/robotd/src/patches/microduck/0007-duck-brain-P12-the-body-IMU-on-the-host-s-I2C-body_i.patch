+//! The body IMU on the host's I²C (duck-brain patch P12): an LSM6DSV16X on the Zero 3W's own
+//! bus, polled by this thread at `[body_imu] poll_hz` and handed to the Feetech tick through
+//! [`ImuFeed`].
+//!
+//! What it gives the observation is what `imu_to_dxl` gave on Pollen's bus, decoded by the same
+//! code: the chip's raw gyro counts (±500 dps) and its SFLP game-rotation quaternion are packed
+//! into the board's 12-byte block and run through [`SflpDecoder`] — the mount, projected gravity —
+//! with the median filter off ([`SflpDecoder::unfiltered`]). There is no magnetometer: heading is
+//! the game quaternion's yaw, which is the chip's integral of its gyro, zero wherever it started.
+//!
+//! The bring-up is `head_imu`'s, which is `imu_to_dxl`'s (reset, reload the trimming, configure,
+//! read back, start SFLP), batching at 120 Hz rather than the head's 60: the tick takes the newest
+//! sample, and a sample's age is part of the observation's.
+//!
+//! A sample is stamped when the poll that fetched it read the FIFO, the newest of a burst at the
+//! read and each earlier one a batch period (8.3 ms) before it. The chip produced the newest one
+//! up to one batch period before that read, so the age `robot.health` reports is short by at most
+//! 8.3 ms.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+
+use duck_control::host_imu::{HostSample, ImuFeed};
+use duck_control::imu::{IMU_BLOCK_LEN, SflpDecoder};
+use robotd_params::Params;
+
+use crate::head_imu::{RECORD, TAG_GYRO, TAG_SFLP_GAME};
+
+/// `[body_imu]` as the reader takes it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Config {
+    pub bus: String,
+    pub address: u16,
+    pub poll_hz: u32,
+    pub mount: [f64; 4],
+}
+
+impl Config {
+    pub fn from(params: &Params) -> Self {
+        Self {
+            bus: params.body_imu.bus.clone(),
+            address: params.body_imu.address,
+            poll_hz: params.body_imu.poll_hz,
+            mount: params.body_imu.mount(),
+        }
+    }
+}
+
+/// FIFO records into `imu_to_dxl` blocks, one per SFLP quaternion: the gyro record before it (or
+/// the previous burst's, kept in `last_gyro`), then the quaternion's three half floats.
+pub fn blocks(burst: &[u8], last_gyro: &mut [u8; 6]) -> Vec<[u8; IMU_BLOCK_LEN]> {
+    let (records, _) = burst.as_chunks::<RECORD>();
+    let mut out = Vec::new();
+    for record in records {
+        match record[0] >> 3 {
+            TAG_GYRO => last_gyro.copy_from_slice(&record[1..7]),
+            TAG_SFLP_GAME => {
+                let mut block = [0u8; IMU_BLOCK_LEN];
+                block[..6].copy_from_slice(last_gyro);
+                block[6..].copy_from_slice(&record[1..7]);
+                out.push(block);
+            }
+            _ => {}
+        }
+    }
+    out
+}
+
+/// Start the reader, on a robot whose `[body_imu]` is on. A thread of its own: it wakes
+/// `poll_hz` times a second, which the control thread must never wait on.
+pub fn start(cfg: Config, feed: Arc<ImuFeed>, shutdown: Arc<AtomicBool>) {
+    let spawned = std::thread::Builder::new()
+        .name("body-imu".into())
+        .spawn(move || run(&cfg, &feed, &shutdown));
+    if let Err(e) = spawned {
+        tracing::error!(error = %e, "cannot start the body IMU reader");
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub use reader::run;
+
+#[cfg(not(target_os = "linux"))]
+pub fn run(_cfg: &Config, feed: &ImuFeed, _shutdown: &AtomicBool) {
+    feed.update_status(|s| {
+        s.error = Some("the body IMU is on I2C, which exists only on Linux".into())
+    });
+}
+
+#[cfg(target_os = "linux")]
+mod reader {
+    use super::*;
+    use crate::head_imu::{Chip, FIFO_DATA_OUT_TAG, FIFO_STATUS1, Rate, WHO_AM_I, WHO_AM_I_VALUE};
+
+    /// More than a poll ever queues at 120 Hz (a few records), less than the FIFO's 512 words.
+    const MAX_WORDS: usize = 64;
+    const RETRY_MIN: Duration = Duration::from_millis(500);
+    const RETRY_MAX: Duration = Duration::from_secs(30);
+
+    fn open(cfg: &Config) -> Result<Chip, String> {
+        let mut chip = Chip::open(&cfg.bus, cfg.address)
+            .map_err(|e| format!("{} {:#04x}: {e}", cfg.bus, cfg.address))?;
+        match chip.read1(WHO_AM_I) {
+            Ok(WHO_AM_I_VALUE) => {}
+            Ok(other) => {
+                return Err(format!(
+                    "{} {:#04x}: WHO_AM_I {other:#04x}, not an LSM6DSV16X",
+                    cfg.bus, cfg.address
+                ));
+            }
+            Err(e) => return Err(format!("{} {:#04x}: {e}", cfg.bus, cfg.address)),
+        }
+        chip.bring_up_at(Rate::Hz120)
+            .map_err(|e| format!("{} {:#04x} did not configure: {e}", cfg.bus, cfg.address))?;
+        Ok(chip)
+    }
+
+    /// Poll the chip until shutdown, publishing every decoded sample. Reopens with backoff on any
+    /// error, and says why in `robot.health`.
+    pub fn run(cfg: &Config, feed: &ImuFeed, shutdown: &AtomicBool) {
+        let period = Duration::from_secs_f64(1.0 / f64::from(cfg.poll_hz.max(1)));
+        let batch = Duration::from_secs_f64(1.0 / f64::from(Rate::Hz120.hz()));
+        let mut backoff = RETRY_MIN;
+        let mut seq = 0u64;
+        feed.update_status(|s| s.started = Some(Instant::now()));
+        while !shutdown.load(Ordering::Acquire) {
+            let mut chip = match open(cfg) {
+                Ok(chip) => chip,
+                Err(why) => {
+                    tracing::warn!(why, "body IMU not available; retrying");
+                    feed.update_status(|s| {
+                        s.device = None;
+                        s.error = Some(why);
+                    });
+                    sleep_unless(backoff, shutdown);
+                    backoff = (backoff * 2).min(RETRY_MAX);
+                    continue;
+                }
+            };
+            let at = format!("{} {:#04x}", cfg.bus, cfg.address);
+            tracing::info!(
+                at,
+                poll_hz = cfg.poll_hz,
+                "body IMU found: LSM6DSV16X, SFLP at 120 Hz"
+            );
+            feed.update_status(|s| {
+                s.device = Some(at.clone());
+                s.error = None;
+            });
+            backoff = RETRY_MIN;
+            let mut decoder = SflpDecoder::unfiltered(cfg.mount);
+            let mut last_gyro = [0u8; 6];
+            let mut burst = vec![0u8; MAX_WORDS * RECORD];
+            let error = loop {
+                if shutdown.load(Ordering::Acquire) {
+                    return;
+                }
+                let tick = Instant::now();
+                let mut level = [0u8; 2];
+                if let Err(e) = chip.read(FIFO_STATUS1, &mut level) {
+                    break e;
+                }
+                let words =
+                    (usize::from(level[0]) | (usize::from(level[1] & 0x01) << 8)).min(MAX_WORDS);
+                let mut n = 0;
+                if words > 0 {
+                    let bytes = &mut burst[..words * RECORD];
+                    if let Err(e) = chip.read(FIFO_DATA_OUT_TAG, bytes) {
+                        break e;
+                    }
+                    let read_at = Instant::now();
+                    let found = blocks(bytes, &mut last_gyro);
+                    n = found.len();
+                    for (i, block) in found.iter().enumerate() {
+                        let imu = decoder.decode(block);
+                        seq += 1;
+                        let behind = batch * (n - 1 - i) as u32;
+                        feed.publish(
+                            HostSample {
+                                imu,
+                                at: read_at.checked_sub(behind).unwrap_or(read_at),
+                                seq,
+                            },
+                            decoder.ready(),
+                        );
+                    }
+                }
+                feed.update_status(|s| {
+                    s.polls += 1;
+                    s.samples += n as u64;
+                });
+                let elapsed = tick.elapsed();
+                if elapsed < period {
+                    std::thread::sleep(period - elapsed);
+                }
+            };
+            tracing::warn!(error = %error, "body IMU read failed; reopening");
+            feed.update_status(|s| s.error = Some(format!("read failed: {error}")));
+            sleep_unless(backoff, shutdown);
+            backoff = (backoff * 2).min(RETRY_MAX);
+        }
+    }
+
+    fn sleep_unless(dur: Duration, shutdown: &AtomicBool) {
+        let mut left = dur;
+        while left > Duration::ZERO && !shutdown.load(Ordering::Acquire) {
+            let step = left.min(Duration::from_millis(50));
+            std::thread::sleep(step);
+            left = left.saturating_sub(step);
+        }
+    }
+}
+
+/// `robotd body-imu`: the reader on its own, printing what the tick would see five times a
+/// second — the bench check of bus, address and mount (docs/board.md in duck-brain). With
+/// `solve`, the mount is measured instead: hold the robot upright, then nose-down, and the
+/// quaternion for `[body_imu.mount]` is printed.
+pub fn bench(params: &Params, solve: bool) -> std::process::ExitCode {
+    let mut cfg = Config::from(params);
+    if solve {
+        // The sensor's own axes: gravity as the chip reads it.
+        cfg.mount = [1.0, 0.0, 0.0, 0.0];
+    }
+    let feed = Arc::new(ImuFeed::new());
+    let shutdown = Arc::new(AtomicBool::new(false));
+    start(cfg.clone(), Arc::clone(&feed), Arc::clone(&shutdown));
+    println!(
+        "body IMU on {} {:#04x}, mount {:?}; Ctrl-C to stop",
+        cfg.bus, cfg.address, cfg.mount
+    );
+    let wait_ready = || {
+        for _ in 0..100 {
+            if feed.ready() {
+                return true;
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        false
+    };
+    if !wait_ready() {
+        let s = feed.status();
+        eprintln!(
+            "no converged sample in 10 s: {}",
+            s.error.unwrap_or_else(|| "no samples".into())
+        );
+        return std::process::ExitCode::FAILURE;
+    }
+    if solve {
+        let mean = |what: &str| {
+            println!("{what}, hold still, then press Enter");
+            let mut line = String::new();
+            let _ = std::io::stdin().read_line(&mut line);
+            let mut sum = [0.0f64; 3];
+            let mut n = 0.0f64;
+            let mut last = None;
+            let until = Instant::now() + Duration::from_secs(1);
+            while Instant::now() < until {
+                if let Some(s) = feed.latest()
+                    && Some(s.seq) != last
+                {
+                    last = Some(s.seq);
+                    for (a, g) in sum.iter_mut().zip(s.imu.gravity) {
+                        *a += g;
+                    }
+                    n += 1.0;
+                }
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            let g = sum.map(|a| a / n.max(1.0));
+            println!(
+                "  gravity in sensor axes {:+.3} {:+.3} {:+.3} ({n} samples)",
+                g[0], g[1], g[2]
+            );
+            g
+        };
+        let up = mean("1/2: the robot upright, as it stands");
+        let nose = mean("2/2: the robot pitched nose-down, 30° or more");
+        shutdown.store(true, Ordering::Release);
+        return match duck_control::host_imu::mount_from_two_poses(up, nose) {
+            Some(q) => {
+                println!(
+                    "[body_imu.mount]\nw = {:.6}\nx = {:.6}\ny = {:.6}\nz = {:.6}",
+                    q[0], q[1], q[2], q[3]
+                );
+                std::process::ExitCode::SUCCESS
+            }
+            None => {
+                eprintln!("the two poses are too close; tilt further");
+                std::process::ExitCode::FAILURE
+            }
+        };
+    }
+    let started = Instant::now();
+    loop {
+        if let Some(s) = feed.latest() {
+            let [gx, gy, gz] = s.imu.gravity;
+            let [wx, wy, wz] = s.imu.gyro;
+            let age_ms = s.at.elapsed().as_secs_f64() * 1000.0;
+            println!(
+                "{:7.1}s gravity {gx:+.3} {gy:+.3} {gz:+.3}   gyro {wx:+.3} {wy:+.3} {wz:+.3} rad/s   age {age_ms:4.1} ms   poll {:.0} Hz, {:.0} samples/s",
+                started.elapsed().as_secs_f64(),
+                feed.poll_hz().unwrap_or(0.0),
+                feed.sample_hz().unwrap_or(0.0),
+            );
+        }
+        std::thread::sleep(Duration::from_millis(200));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn record(tag: u8, data: [u8; 6]) -> [u8; 7] {
+        let mut r = [0u8; 7];
+        r[0] = tag << 3;
+        r[1..].copy_from_slice(&data);
+        r
+    }
+
+    /// The board's 2026-10-06 burst (head_imu's test) packs into an `imu_to_dxl` block that the
+    /// body decoder reads as a level sensor: gyro bytes first, then the quaternion's.
+    #[test]
+    fn records_pack_into_the_imu_to_dxl_block() {
+        let mut burst = Vec::new();
+        burst.extend(record(TAG_GYRO, [0xf1, 0x06, 0xb8, 0x0b, 0x1f, 0xee]));
+        burst.extend(record(
+            crate::head_imu::TAG_ACCEL,
+            [0xf7, 0xff, 0x14, 0x14, 0x05, 0xff],
+        ));
+        burst.extend(record(TAG_SFLP_GAME, [0xc9, 0x39, 0x7b, 0x18, 0x8a, 0x16]));
+        let mut last = [0u8; 6];
+        let found = blocks(&burst, &mut last);
+        assert_eq!(found.len(), 1);
+        assert_eq!(found[0][..6], [0xf1, 0x06, 0xb8, 0x0b, 0x1f, 0xee]);
+        assert_eq!(found[0][6..], [0xc9, 0x39, 0x7b, 0x18, 0x8a, 0x16]);
+        // Unfiltered: the first block's gyro is the block's own, not a median with zeros.
+        let mut d = SflpDecoder::unfiltered([1.0, 0.0, 0.0, 0.0]);
+        let imu = d.decode(&found[0]);
+        let lsb = 0.0175 * std::f64::consts::PI / 180.0;
+        assert!((imu.gyro[0] - 1777.0 * lsb).abs() < 1e-9, "{:?}", imu.gyro);
+        // A quaternion with no gyro before it in this burst takes the previous burst's.
+        let found = blocks(&record(TAG_SFLP_GAME, [0; 6]), &mut last);
+        assert_eq!(found[0][..6], [0xf1, 0x06, 0xb8, 0x0b, 0x1f, 0xee]);
+    }
+}
