+/// The sensor→trunk mount from two still poses, as gravity measured in the sensor's own axes
+/// (an identity mount): the robot upright, and the robot pitched nose-down by any clear angle.
+///
+/// Upright, gravity is the trunk's −z; nose-down it gains a +x part and no y part (trunk `x`
+/// forward, `y` left, `z` up). So the trunk's axes, in sensor coordinates, are `z = −up`,
+/// `x` = the nose-down reading with its `z` part removed, `y = z × x` — the rows of the matrix
+/// that takes a sensor vector into the trunk, which is what [`crate::imu::SflpDecoder`]'s mount
+/// does. `None` when the two poses are too close to tell an axis from.
+pub fn mount_from_two_poses(upright: [f64; 3], nose_down: [f64; 3]) -> Option<[f64; 4]> {
+    let dot = |a: [f64; 3], b: [f64; 3]| a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+    let unit = |v: [f64; 3]| {
+        let n = dot(v, v).sqrt();
+        (n > 1e-6).then(|| v.map(|c| c / n))
+    };
+    let z = unit(upright.map(|c| -c))?;
+    let d = dot(nose_down, z);
+    let x_raw = [
+        nose_down[0] - d * z[0],
+        nose_down[1] - d * z[1],
+        nose_down[2] - d * z[2],
+    ];
+    // Less than ~6° of tilt is not a pose, it is a hand shaking.
+    if dot(x_raw, x_raw).sqrt() < 0.1 * dot(nose_down, nose_down).sqrt() {
+        return None;
+    }
+    let x = unit(x_raw)?;
+    let y = [
+        z[1] * x[2] - z[2] * x[1],
+        z[2] * x[0] - z[0] * x[2],
+        z[0] * x[1] - z[1] * x[0],
+    ];
+    // Rows x, y, z: trunk = R · sensor. Quaternion of R (Shepperd), scalar first, w ≥ 0.
+    let r = [x, y, z];
+    let trace = r[0][0] + r[1][1] + r[2][2];
+    let q = if trace > 0.0 {
+        let s = (trace + 1.0).sqrt() * 2.0;
+        [
+            0.25 * s,
+            (r[2][1] - r[1][2]) / s,
+            (r[0][2] - r[2][0]) / s,
+            (r[1][0] - r[0][1]) / s,
+        ]
+    } else if r[0][0] > r[1][1] && r[0][0] > r[2][2] {
+        let s = (1.0 + r[0][0] - r[1][1] - r[2][2]).sqrt() * 2.0;
+        [
+            (r[2][1] - r[1][2]) / s,
+            0.25 * s,
+            (r[0][1] + r[1][0]) / s,
+            (r[0][2] + r[2][0]) / s,
+        ]
+    } else if r[1][1] > r[2][2] {
+        let s = (1.0 + r[1][1] - r[0][0] - r[2][2]).sqrt() * 2.0;
+        [
+            (r[0][2] - r[2][0]) / s,
+            (r[0][1] + r[1][0]) / s,
+            0.25 * s,
+            (r[1][2] + r[2][1]) / s,
+        ]
+    } else {
+        let s = (1.0 + r[2][2] - r[0][0] - r[1][1]).sqrt() * 2.0;
+        [
+            (r[1][0] - r[0][1]) / s,
+            (r[0][2] + r[2][0]) / s,
+            (r[1][2] + r[2][1]) / s,
+            0.25 * s,
+        ]
+    };
+    let q = if q[0] < 0.0 { q.map(|c| -c) } else { q };
+    let n = dot([q[1], q[2], q[3]], [q[1], q[2], q[3]]) + q[0] * q[0];
+    Some(q.map(|c| c / n.sqrt()))
+}
