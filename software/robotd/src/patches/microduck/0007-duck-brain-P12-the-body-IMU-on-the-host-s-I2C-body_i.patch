+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::imu::SflpDecoder;
+
+    /// Rotate by a scalar-first quaternion.
+    fn rotate(q: [f64; 4], v: [f64; 3]) -> [f64; 3] {
+        let [w, x, y, z] = q;
+        let t = [
+            2.0 * (y * v[2] - z * v[1]),
+            2.0 * (z * v[0] - x * v[2]),
+            2.0 * (x * v[1] - y * v[0]),
+        ];
+        [
+            v[0] + w * t[0] + (y * t[2] - z * t[1]),
+            v[1] + w * t[1] + (z * t[0] - x * t[2]),
+            v[2] + w * t[2] + (x * t[1] - y * t[0]),
+        ]
+    }
+
+    /// Gravity a sensor mounted with `mount` reads, for a trunk-frame gravity `g`.
+    fn sensed(mount: [f64; 4], g: [f64; 3]) -> [f64; 3] {
+        let inverse = [mount[0], -mount[1], -mount[2], -mount[3]];
+        rotate(inverse, g)
+    }
+
+    /// The two-pose solve recovers Pollen's two known mounts and an arbitrary one.
+    #[test]
+    fn two_poses_recover_the_mount() {
+        let h = std::f64::consts::FRAC_1_SQRT_2;
+        let odd = {
+            let (a, b, c, d) = (0.3f64, -0.5, 0.7, 0.2);
+            let n = (a * a + b * b + c * c + d * d).sqrt();
+            [a / n, b / n, c / n, d / n]
+        };
+        for mount in [
+            SflpDecoder::DEFAULT_MOUNT,
+            SflpDecoder::BETA_MOUNT,
+            [0.5, 0.5, -0.5, -0.5],
+            odd,
+            [h, 0.0, 0.0, h],
+        ] {
+            let up = sensed(mount, [0.0, 0.0, -1.0]);
+            let theta = 0.6f64;
+            let nose = sensed(mount, [theta.sin(), 0.0, -theta.cos()]);
+            let got = mount_from_two_poses(up, nose).expect("solvable");
+            let same = got.iter().zip(mount).all(|(a, b)| (a - b).abs() < 1e-9)
+                || got.iter().zip(mount).all(|(a, b)| (a + b).abs() < 1e-9);
+            assert!(same, "mount {mount:?}, solved {got:?}");
+        }
+        assert_eq!(
+            mount_from_two_poses([0.0, 0.0, -1.0], [0.0, 0.01, -1.0]),
+            None,
+            "no tilt"
+        );
+    }
+}
