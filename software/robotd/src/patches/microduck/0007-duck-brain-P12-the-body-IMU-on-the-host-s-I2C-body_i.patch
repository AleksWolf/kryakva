+/// `[body_imu]` — the duck-brain robot's LSM6DSV16X on the Zero 3W's own I²C (duck-brain P12).
+///
+/// Bus, address and mount depend on how the chip is wired and fixed in the body, which nobody
+/// has measured yet: the shipped values are where to start, and `robotd body-imu` is how to check
+/// them (docs/board.md in duck-brain).
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, default)]
+pub struct BodyImuParams {
+    /// Read it at all. Absent means: on when `[bus] driver = "feetech"`, which has no other IMU.
+    pub enabled: Option<bool>,
+    /// The i2c-dev node. Header pins 3/5 are `i2c3` once the overlay is loaded.
+    pub bus: String,
+    /// 0x6a with SA0 low, 0x6b with SA0 high.
+    pub address: u16,
+    /// FIFO polls per second; the chip batches at 120 Hz, so a sample waits at most one poll.
+    pub poll_hz: u32,
+    /// Sensor→trunk rotation, scalar first: trunk `x` forward, `y` left, `z` up.
+    pub mount: Mount,
+}
+
+/// A unit quaternion, scalar first.
+#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Mount {
+    pub w: f64,
+    pub x: f64,
+    pub y: f64,
+    pub z: f64,
+}
+
+impl Default for BodyImuParams {
+    fn default() -> Self {
+        Self {
+            enabled: None,
+            bus: "/dev/i2c-3".into(),
+            address: 0x6a,
+            poll_hz: 200,
+            mount: Mount {
+                w: 1.0,
+                x: 0.0,
+                y: 0.0,
+                z: 0.0,
+            },
+        }
+    }
+}
+
+impl BodyImuParams {
+    /// Whether the host IMU is read for a robot whose bus is `driver`.
+    pub fn enabled_for(&self, driver: BusDriver) -> bool {
+        self.enabled.unwrap_or(driver == BusDriver::Feetech)
+    }
+
+    /// The mount, normalised.
+    pub fn mount(&self) -> [f64; 4] {
+        let m = self.mount;
+        let n = (m.w * m.w + m.x * m.x + m.y * m.y + m.z * m.z).sqrt();
+        [m.w / n, m.x / n, m.y / n, m.z / n]
+    }
+}
