diff --git a/robotd/src/journal.rs b/robotd/src/journal.rs
new file mode 100644
index 0000000..ceceef5
--- /dev/null
+++ b/robotd/src/journal.rs
@@ -0,0 +1,121 @@
+//! The tick journal (duck-brain patch P13): `robotd --journal <file>` writes one JSON line per
+//! control tick — time, the policy's whole input row and its output, the targets, what the servos
+//! reported and what was sent to them — so a run on the robot can be fed back through the same
+//! network on a PC and compared bit for bit (`scripts/replay_journal.py` in duck-brain).
+//!
+//! Floats go out as the shortest decimal that reads back to the same `f64`; an `f32` is widened
+//! first, exactly, so reading a value back as `f64` and narrowing it gives the very bits the
+//! policy saw.
+//!
+//! Written from a thread of its own through a bounded queue: the control thread formats a line
+//! and hands it over, and never waits on a disk. A full queue drops the line and counts it; the
+//! count is written at the end, so a journal with holes says so.
+
+use std::io::Write;
+use std::path::Path;
+use std::sync::mpsc::{SyncSender, TrySendError, sync_channel};
+
+/// About ten seconds of ticks at 50 Hz.
+const QUEUE: usize = 512;
+
+pub struct Journal {
+    tx: Option<SyncSender<String>>,
+    thread: Option<std::thread::JoinHandle<std::io::Result<()>>>,
+    pub dropped: u64,
+    pub written: u64,
+}
+
+impl Journal {
+    /// Create `path` (truncating) and write `header` as its first line.
+    pub fn open(path: &Path, header: &serde_json::Value) -> std::io::Result<Self> {
+        let file = std::fs::File::create(path)?;
+        let mut out = std::io::BufWriter::with_capacity(1 << 16, file);
+        serde_json::to_writer(&mut out, header)?;
+        out.write_all(b"\n")?;
+        out.flush()?;
+        let (tx, rx) = sync_channel::<String>(QUEUE);
+        let thread = std::thread::Builder::new()
+            .name("journal".into())
+            .spawn(move || {
+                for (n, line) in rx.iter().enumerate() {
+                    out.write_all(line.as_bytes())?;
+                    out.write_all(b"\n")?;
+                    // Once a second, so a crash loses little and a reader can follow along.
+                    if n % 50 == 49 {
+                        out.flush()?;
+                    }
+                }
+                out.flush()
+            })?;
+        Ok(Self {
+            tx: Some(tx),
+            thread: Some(thread),
+            dropped: 0,
+            written: 0,
+        })
+    }
+
+    /// Queue one record; never blocks.
+    pub fn write(&mut self, record: &serde_json::Value) {
+        let Some(tx) = &self.tx else { return };
+        match tx.try_send(record.to_string()) {
+            Ok(()) => self.written += 1,
+            Err(TrySendError::Full(_)) => self.dropped += 1,
+            Err(TrySendError::Disconnected(_)) => {
+                tracing::error!("tick journal writer stopped; no more lines");
+                self.tx = None;
+            }
+        }
+    }
+}
+
+impl Drop for Journal {
+    fn drop(&mut self) {
+        if let Some(tx) = self.tx.take() {
+            let _ = tx.send(
+                serde_json::json!({ "end": { "written": self.written, "dropped": self.dropped } })
+                    .to_string(),
+            );
+        }
+        if let Some(thread) = self.thread.take() {
+            match thread.join() {
+                Ok(Ok(())) => tracing::info!(
+                    written = self.written,
+                    dropped = self.dropped,
+                    "tick journal closed"
+                ),
+                Ok(Err(e)) => tracing::error!(error = %e, "tick journal write failed"),
+                Err(_) => tracing::error!("tick journal writer panicked"),
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A header, the records, and an end line with the counts; an f32 reads back to its bits.
+    #[test]
+    fn lines_round_trip_and_the_end_is_counted() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("j.jsonl");
+        let x: f32 = 0.1;
+        {
+            let mut j = Journal::open(&path, &serde_json::json!({ "journal": 1 })).unwrap();
+            j.write(&serde_json::json!({ "obs": [x, -1.0e-7f32, f32::MIN_POSITIVE] }));
+        }
+        let text = std::fs::read_to_string(&path).unwrap();
+        let lines: Vec<serde_json::Value> = text
+            .lines()
+            .map(|l| serde_json::from_str(l).unwrap())
+            .collect();
+        assert_eq!(lines.len(), 3);
+        let back = lines[1]["obs"][0].as_f64().unwrap() as f32;
+        assert_eq!(back.to_bits(), x.to_bits());
+        let tiny = lines[1]["obs"][2].as_f64().unwrap() as f32;
+        assert_eq!(tiny.to_bits(), f32::MIN_POSITIVE.to_bits());
+        assert_eq!(lines[2]["end"]["written"], 1);
+        assert_eq!(lines[2]["end"]["dropped"], 0);
+    }
+}
