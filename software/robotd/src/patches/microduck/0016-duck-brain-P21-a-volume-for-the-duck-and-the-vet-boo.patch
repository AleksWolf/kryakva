+    /// `[audio] volume` (P21): samples and raw bytes scaled alike, clamped to 0–1, 1 untouched.
+    #[test]
+    fn the_volume_scales_every_sample() {
+        let mut s = vec![10_000i16, -10_000, 32_767];
+        scale_samples(&mut s, 0.5);
+        assert_eq!(s, [5_000, -5_000, 16_384]);
+        let mut b: Vec<u8> = [10_000i16, -32_768]
+            .iter()
+            .flat_map(|x| x.to_le_bytes())
+            .collect();
+        scale_bytes(&mut b, 0.25);
+        assert_eq!(
+            b,
+            [2_500i16, -8_192]
+                .iter()
+                .flat_map(|x| x.to_le_bytes())
+                .collect::<Vec<_>>()
+        );
+        let mut same = vec![1i16, -1];
+        scale_samples(&mut same, 1.0);
+        assert_eq!(same, [1, -1]);
+        let bank = PathBuf::from("/nonexistent");
+        assert_eq!(Sound::new(bank.clone(), "null".into()).volume, 1.0);
+        assert_eq!(
+            Sound::new(bank.clone(), "null".into())
+                .with_volume(2.0)
+                .volume,
+            1.0
+        );
+        assert_eq!(
+            Sound::new(bank.clone(), "null".into())
+                .with_volume(-1.0)
+                .volume,
+            0.0
+        );
+        assert_eq!(
+            Sound::new(bank, "null".into()).with_volume(f64::NAN).volume,
+            1.0
+        );
+    }
