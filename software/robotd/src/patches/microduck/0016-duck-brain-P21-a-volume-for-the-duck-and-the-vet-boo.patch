+/// Samples times `volume` (P21); 1 leaves them as they are.
+fn scale_samples(samples: &mut [i16], volume: f32) {
+    if volume < 1.0 {
+        for s in samples {
+            *s = (f32::from(*s) * volume).round() as i16;
+        }
+    }
+}
+
+/// The same on raw S16LE bytes (the wheee segments).
+fn scale_bytes(pcm: &mut [u8], volume: f32) {
+    if volume < 1.0 {
+        for c in pcm.chunks_exact_mut(2) {
+            let s = (f32::from(i16::from_le_bytes([c[0], c[1]])) * volume).round() as i16;
+            c.copy_from_slice(&s.to_le_bytes());
+        }
+    }
+}
+
 /// `d` of `wav`, in interleaved samples.
 fn samples_in(wav: &Wav16, d: Duration) -> usize {
     (d.as_secs_f64() * f64::from(wav.rate)).round() as usize * usize::from(wav.channels)
