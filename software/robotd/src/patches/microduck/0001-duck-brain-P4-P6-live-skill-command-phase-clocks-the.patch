+/// The observation's blocks, in order, as training exports name them in the ONNX metadata
+/// (`observation_names`). A network that names its inputs is checked against this at load, so a
+/// policy trained on another layout is refused rather than fed the wrong numbers (duck-brain P5).
+pub const OBSERVATION_NAMES: [&str; 8] = [
+    "base_ang_vel",
+    "projected_gravity",
+    "joint_pos",
+    "joint_vel",
+    "actions",
+    "command",
+    "head_command",
+    "body_command",
+];
+
+/// A clock some networks read after the 61 inputs: `sin φ, cos φ`.
+pub const PHASE_LEN: usize = 2;
+
+/// The step the clocks advance by — the 50 Hz the policies were trained at.
+pub const CONTROL_DT: f64 = 0.02;
+
+/// Where the twist sits in the observation: after gyro, gravity and three joint blocks.
+const COMMAND_AT: usize = 3 + 3 + 3 * OBS_JOINTS;
+
+/// Which clock, if any, a network observes after the 61 inputs, from its last `observation_names`
+/// entry (duck-brain P5).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Clock {
+    /// 61 inputs.
+    None,
+    /// `swizzle_phase` — the roller ride and crouch: φ += 2π·f·dt every step, f from the commanded
+    /// speed ([`swizzle_hz`]); φ stands while the duck is not asked to move.
+    Swizzle,
+    /// `fish_phase` — the Fish slalom: φ = 2π·t/period, t from the start of the episode. The
+    /// period is the skill's (`phase_period_s`), not in the network.
+    Fish,
+}
+
+/// The swizzle clock's frequency, Hz, as training drives it (duck-brain docs/skills.md, from
+/// `SwizzleClockCommand` in Alex's microduck_rl): f = min(|v| / (4.1 · 0.15), 1.5), zero at
+/// |v| ≤ 0.05 m/s, and × (1 − u/0.3) for the crouch depth u = cmd[1] in [0, 0.3] — which is zero
+/// for the plain ride, so one formula serves both.
+pub fn swizzle_hz(speed: f64, depth: f64) -> f64 {
+    if speed.abs() <= 0.05 {
+        return 0.0;
+    }
+    let u = depth.clamp(0.0, 0.3);
+    (speed.abs() / (4.1 * 0.15)).min(1.5) * (1.0 - u / 0.3)
+}
 
