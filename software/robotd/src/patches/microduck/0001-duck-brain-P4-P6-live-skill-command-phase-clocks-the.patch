+        assert_eq!(layout(p, Some(&format!("{base},fish_phase"))).unwrap(), Clock::Fish);
+        assert!(layout(p, Some(&format!("{base},stride_phase"))).is_err());
+        let swapped = base.replace("joint_pos,joint_vel", "joint_vel,joint_pos");
+        assert!(layout(p, Some(&swapped)).is_err(), "the order is checked, not just the names");
