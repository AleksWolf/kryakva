+/// The clock a network reads, from its `observation_names`: the 61 blocks of
+/// [`OBSERVATION_NAMES`], in order, optionally followed by `swizzle_phase` or `fish_phase`. A network
+/// that does not name its inputs is taken to be the 61 (every policy before P5).
+pub fn layout(path: &Path, names: Option<&str>) -> Result<Clock, PolicyError> {
+    let Some(names) = names else { return Ok(Clock::None) };
+    let names: Vec<&str> = names.split(',').map(str::trim).collect();
+    let bad = || shape_error(path, "observation_names",
+        &format!("{} [+ swizzle_phase | fish_phase]", OBSERVATION_NAMES.join(",")), names.join(","));
+    if names.len() < OBSERVATION_NAMES.len() || names[..OBSERVATION_NAMES.len()] != OBSERVATION_NAMES {
+        return Err(bad());
+    }
+    match &names[OBSERVATION_NAMES.len()..] {
+        [] => Ok(Clock::None),
+        ["swizzle_phase"] => Ok(Clock::Swizzle),
+        ["fish_phase"] => Ok(Clock::Fish),
+        _ => Err(bad()),
+    }
+}
+
+/// HOME and action scale from the metadata (duck-brain P6). `default_joint_pos` is in the policy's
+/// joint order — the 14 without the mouth, which `joint_names` must confirm when present; the
+/// mouth keeps the compiled default.
+pub fn trained_pose(
+    path: &Path,
+    joint_names: Option<&str>,
+    default_pos: Option<&str>,
+    scale: Option<&str>,
+) -> Result<(Option<[f64; NUM_JOINTS]>, Option<f64>), PolicyError> {
+    if let Some(names) = joint_names {
+        let want: Vec<&str> = crate::model::JOINT_NAMES.iter().copied().filter(|n| *n != "mouth").collect();
+        let got: Vec<&str> = names.split(',').map(str::trim).collect();
+        if got != want {
+            return Err(shape_error(path, "joint_names", &want.join(","), got.join(",")));
+        }
+    }
+    let home = match default_pos {
+        None => None,
+        Some(text) => {
+            let v: Vec<f64> = text.split(',').map(|x| x.trim().parse::<f64>()).collect::<Result<_, _>>()
+                .map_err(|_| shape_error(path, "default_joint_pos", "14 numbers", text.to_owned()))?;
+            if v.len() != OBS_JOINTS || !v.iter().all(|x| x.is_finite() && x.abs() < 3.2) {
+                return Err(shape_error(path, "default_joint_pos", "14 finite angles", text.to_owned()));
+            }
+            let mut pose = DEFAULT_POSITION;
+            for (slot, value) in v.iter().enumerate() {
+                pose[if slot < MOUTH_INDEX { slot } else { slot + 1 }] = *value;
+            }
+            Some(pose)
+        }
+    };
+    let scale = match scale {
+        None => None,
+        Some(text) => match text.trim().parse::<f64>() {
+            Ok(x) if x.is_finite() && x > 0.0 && x <= 2.0 => Some(x),
+            _ => return Err(shape_error(path, "action_scale", "a number in (0, 2]", text.to_owned())),
+        },
+    };
+    Ok((home, scale))
+}
