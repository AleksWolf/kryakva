+        let ours = "0.000,-0.087,-0.371,-0.005,0.366,0.349,0.349,0.000,0.000,0.000,0.087,0.371,0.005,-0.366";
+        let (home, scale) = trained_pose(p, Some(names), Some(ours), Some("0.3")).unwrap();
+        let home = home.unwrap();
+        assert_eq!((home[2], home[4], home[MOUTH_INDEX], home[12], home[14]), (-0.371, 0.366, DEFAULT_POSITION[MOUTH_INDEX], 0.371, -0.366));
+        assert_eq!(scale, Some(0.3));
