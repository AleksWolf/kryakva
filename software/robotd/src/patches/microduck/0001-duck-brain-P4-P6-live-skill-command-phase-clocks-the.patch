+
+    #[test]
+    fn the_swizzle_clock_follows_the_speed_and_the_crouch() {
+        assert_eq!(swizzle_hz(0.04, 0.0), 0.0, "stands still below 0.05 m/s");
+        assert!((swizzle_hz(0.3, 0.0) - 0.3 / 0.615).abs() < 1e-12, "0.3 m/s → 0.49 Hz");
+        assert_eq!(swizzle_hz(-2.0, 0.0), 1.5, "capped, either direction");
+        assert!((swizzle_hz(0.3, 0.15) - 0.5 * 0.3 / 0.615).abs() < 1e-12, "half depth, half the beat");
+        assert_eq!(swizzle_hz(0.3, 0.3), 0.0);
+    }
+
