+"""Microduck package. On import: check that MuJoCo Warp has the plane-convex contact patch (patch_mujoco_warp.py).
+
+mujoco_warp's plane_convex picks extra contact points among hull vertices within 1 mm of the deepest one; on the rounded
+roller tyre that is a +-5 mm flat patch along the rolling direction. patch_mujoco_warp.py sets the tolerance to 0.01 mm
+for condim-4 contacts only (the roller tyres); all other contacts keep 1 mm. MICRODUCK_WARP_STOCK=1 skips this check
+only and does not revert the engine (revert: patch_mujoco_warp.py --revert).
+"""
+import os as _os
+from pathlib import Path as _Path
+
+if _os.environ.get("MICRODUCK_WARP_STOCK") != "1":
+    try:
+        import mujoco_warp as _mjw
+        _src = (_Path(_mjw.__file__).parent / "_src" / "collision_primitive.py").read_text(encoding="utf-8")
+    except Exception:                                                     # no mujoco_warp in this interpreter: nothing to check
+        _src = None
+    if _src is not None and "condim == 4, 1e-5, 1e-3" not in _src:
+        raise RuntimeError("mujoco_warp without the plane-convex contact fix: run "
+                           "`python training/patches/patch_mujoco_warp.py` with this interpreter "
+                           "(or MICRODUCK_WARP_STOCK=1 to skip this check for a stock-engine A/B)")
