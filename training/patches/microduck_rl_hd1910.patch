+class BacklashGapBamActuator(FrictionDRBamActuator):
+    """FrictionDRBamActuator with gear backlash as a torque gap on one joint.
+
+    Gear play is a hidden motor-side state: rotor angle m and speed md per joint. The link (MuJoCo joint q) receives
+    the motor torque only while the rotor presses on it from the side the torque points to (m - q = +gap/2 for
+    tau > 0, -gap/2 for tau < 0). On a torque reversal the rotor crosses the gap on its own inertia (BAM armature)
+    and the link gets no torque meanwhile: t = sqrt(2 * gap * J / |tau|). The encoder is on the output side, so the
+    firmware PD reads q. Approximation: the rotor inertia also stays lumped in the MuJoCo joint armature.
+    """
+
+    def initialize(self, mj_model, model, data, device) -> None:
+        super().initialize(mj_model, model, data, device)
+        n, j = self.kp_scale.shape[0], len(self._target_names)
+        self._half_gap = math.radians(self.cfg.gap_deg) / 2.0
+        self._j_rotor = float(self._bam_model.armature.value)
+        self._m = torch.zeros(n, j, device=device)
+        self._md = torch.zeros(n, j, device=device)
+        self._need_init = torch.ones(n, dtype=torch.bool, device=device)
+        print(f"[BacklashGapBamActuator] gear play {self.cfg.gap_deg:g} deg total (+/-{math.degrees(self._half_gap):.3g}), "
+              f"rotor J {self._j_rotor:.5f}")
+
+    def reset(self, env_ids=None) -> None:
+        super().reset(env_ids)
+        if getattr(self, "_need_init", None) is not None:
+            self._need_init[slice(None) if env_ids is None else env_ids] = True
+
+    def compute(self, cmd: ActuatorCmd) -> torch.Tensor:
+        tau = super().compute(cmd)
+        qd = cmd.vel
+        ini = self._need_init
+        if bool(ini.any()):
+            self._m[ini] = 0.0; self._md[ini] = qd[ini]; ini[:] = False
+        # self._m holds the rotor OFFSET from the link (rotor - link), so an engaged rotor moves with the link
+        h, dt = self._half_gap, self._dt
+        side = torch.sign(tau)
+        engaged = (side != 0) & (self._m * side >= h - 1e-9)      # rotor already on the wall the torque pushes to
+        md_free = self._md + tau / self._j_rotor * dt               # free rotor on its own inertia, link gets nothing
+        off_free = self._m + (md_free - qd) * dt
+        hit = off_free.abs() >= h                                   # reached a wall: locks to the link, transmits next step
+        self._m = torch.where(engaged, side * h, torch.clamp(off_free, -h, h))
+        self._md = torch.where(engaged | hit, qd, md_free)
+        return torch.where(engaged, tau, torch.zeros_like(tau))
+
+
+@dataclass(kw_only=True)
+class BacklashGapBamActuatorCfg(FrictionDRBamActuatorCfg):
+    """FrictionDRBamActuatorCfg + gear play as a torque gap (total degrees, peak to peak)."""
+
+    gap_deg: float = 0.5
+
+    def build(self, entity, target_ids, target_names) -> BacklashGapBamActuator:
+        return BacklashGapBamActuator(self, entity, target_ids, target_names)
